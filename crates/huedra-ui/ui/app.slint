// The settings window: navigation and the five pages.
// Layouts: wide (1000 px and up), medium (680 to 999), compact (below 680,
// icon rail). Feature doc: docs/features/08-settings-window.md

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FocusRing, ActionButton } from "controls.slint";
import {
    StatusPage, GamesPage, VideoPage, DisplaysPage, SettingsPage, SetupPage,
    GameRow, GameDetail, DisplayRow, HistoryRow, NowRow, StoreChip, VideoAppRow, SiteRow, UpdateNote
} from "pages.slint";

import { FlyoutWindow, FlyDisplay } from "flyout.slint";

export { FlyoutWindow, FlyDisplay }
export { Theme, GameRow, GameDetail, DisplayRow, HistoryRow, NowRow, StoreChip, VideoAppRow, SiteRow, UpdateNote }

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    in property <bool> compact;
    // The navigation pane has the keyboard focus, reached with the keyboard.
    in property <bool> keyboard-focus;
    callback activate();
    height: Theme.nav-row;
    border-radius: Theme.radius-control;
    background: selected ? Theme.surface-raised : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.hover-time; }
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: selected;
    accessible-action-default => {
        root.activate();
    }
    Rectangle {
        x: 0;
        width: 3px;
        height: selected ? 16px : 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: Theme.control; }
    }
    HorizontalLayout {
        padding-left: root.compact ? 0px : 14px;
        spacing: 12px;
        alignment: root.compact ? center : start;
        Text {
            text: root.glyph;
            font-family: Theme.icons;
            font-size: 16px;
            color: Theme.text;
            vertical-alignment: center;
            width: 20px;
            horizontal-alignment: center;
        }
        if !root.compact: Text {
            text: root.label;
            font-size: Theme.body-size;
            font-weight: root.selected ? 600 : 400;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => {
            root.activate();
        }
    }
    if root.selected && root.keyboard-focus: FocusRing {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius-control;
    }
}

export component SettingsWindow inherits Window {
    title: "Huedra";
    // Wide enough for Status's two cards side by side.
    preferred-width: 1100px;
    preferred-height: 780px;
    min-width: 520px;
    min-height: 560px;
    // Windows 11 22H2 and later: the navigation pane shows the Mica backdrop.
    in property <bool> mica;
    background: root.mica ? transparent : Theme.background;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: Theme.body-size;

    in-out property <int> page: 0;
    // Set when the width changes rather than bound to it: the layouts below
    // depend on them and in turn constrain the width.
    property <bool> wide: true;
    property <bool> compact: false;
    changed width => {
        root.fit-layout();
    }
    init => {
        root.fit-layout();
        root.apply-theme();
    }

    // The Windows light or dark app setting, watched by Huedra itself:
    // Slint's own tracking can miss a change while the window is open.
    in property <bool> light-theme: true;
    changed light-theme => {
        root.apply-theme();
    }

    function apply-theme() {
        Palette.color-scheme = root.light-theme ? ColorScheme.light : ColorScheme.dark;
    }

    function fit-layout() {
        root.wide = root.width >= 1000px;
        root.compact = root.width < 680px;
    }

    // Status
    in property <bool> tray-running;
    in property <bool> hdr-on;
    in property <string> headline: "HDR is off";
    // One line under the state in the navigation pane.
    in property <string> nav-detail;
    in property <string> detail;
    in property <string> caption;
    in property <int> mode;
    in property <bool> paused;
    in property <string> pause-note;
    in property <[HistoryRow]> history;
    // What holds HDR now, and the line shown when nothing does.
    in property <[NowRow]> now;
    in property <string> idle;
    // Every connected display, for the Status page.
    in property <[DisplayRow]> status-displays;
    // The newest failed switch; empty once closed.
    in property <string> failure;
    // Closes the update notices until the window opens again.
    property <bool> update-bar-closed;
    callback set-mode(int);
    callback toggle-pause();
    callback start-huedra();
    callback close-failure();
    // "Huedra has a new look", once, for people who used Huedra before.
    in-out property <bool> new-look;
    callback close-new-look();

    // Games
    in property <[GameRow]> games;
    in property <[StoreChip]> chips;
    in property <[StoreChip]> cue-chips;
    in property <int> suggest-count;
    in-out property <bool> games-grid;
    in property <string> filter: "all";
    in property <int> game-total;
    in property <[GameDetail]> details;
    in property <string> selected-id;
    in property <string> scan-note;
    callback search-changed(string);
    callback filter-changed(string);
    callback select-game(string);
    callback close-detail();
    callback add-game();
    callback rescan();
    callback apply-all-suggestions();
    callback games-grid-shown();
    callback set-game-setting(string, int);
    callback set-game-delay(string, int);
    callback set-game-hold(string, int);
    callback reset-game-timing(string);
    callback apply-suggestion(string);
    callback open-wiki(string);
    callback remove-game(string);
    callback create-shortcut(string);
    callback set-game-steam-start(string, bool);
    // The installed color profiles, "Windows default" first.
    in property <[string]> sdr-profiles;
    // "As set in Windows", then the main display's modes.
    in property <[string]> display-modes;
    in property <[string]> hdr-profiles;
    callback set-game-auto-hdr(string, int);
    callback set-game-display-mode(string, int);
    callback set-game-profile(string, bool, int);

    // Displays
    in property <[VideoAppRow]> video-players;
    in property <[VideoAppRow]> video-browsers;
    in property <string> video-keywords;
    in property <bool> video-full-screen-only;
    in property <bool> video-sdr-with-rtx;
    in property <string> video-rtx-note;
    in property <[SiteRow]> video-sites;
    in property <int> video-hold;
    in property <bool> video-hold-custom;
    callback set-video-app(string, int);
    callback set-video-keywords(string);
    callback set-video-full-screen-only(bool);
    callback set-video-sdr-with-rtx(bool);
    callback set-video-site(string, bool);
    callback set-video-hold(int);
    callback reset-video-hold();

    in property <[DisplayRow]> displays;
    in property <int> retries;
    in property <bool> content-only;
    in property <bool> main-only;
    callback set-brightness(string, int);
    callback set-controlled(string, bool);
    callback set-retries(int);
    callback set-content-only(bool);
    callback set-main-only(bool);

    // Settings
    in property <bool> start-with-windows;
    in property <bool> context-menu;
    in property <int> updates;
    in property <int> close-action;
    in property <bool> game-info;
    in property <int> hold;
    in property <int> delay;
    in property <bool> hotkeys;
    // Each shortcut's keys ("Win+Alt+H"); empty when it is off.
    in property <string> keys-hdr;
    in property <string> keys-mode;
    in property <string> keys-pause;
    // Why the last shortcut typed was not taken.
    in property <string> shortcut-error;
    // Shortcuts Windows refused, from the tray process.
    in property <string> shortcut-note;
    in property <bool> log-titles;
    in property <bool> notify-failures;
    in property <bool> battery-sdr;
    in property <string> version;
    in property <string> data-folder;
    in property <string> update-note;
    in property <bool> can-check-updates;
    in property <bool> checking-updates;
    in property <string> update-check-status;
    in property <string> install-version;
    in property <bool> has-project-page;
    callback check-updates();
    callback install-update();
    callback open-project();
    // The update dialog: what is new in the version waiting, and Download
    // and install.
    in-out property <bool> show-update;
    in property <string> update-version;
    in property <[UpdateNote]> update-notes;
    in property <int> update-more;
    in property <bool> has-changelog;
    in property <bool> installing-update;
    in property <string> update-status;
    callback open-changelog();
    callback open-support();
    // Video players › Browsers: the extension's store page.
    callback open-extension();

    // Disclaimer: shown until accepted; the tray does not run before that.
    in-out property <bool> show-disclaimer;
    in property <bool> disclaimer-accepted;
    callback accept-disclaimer();
    // First-run setup, after the disclaimer is first accepted.
    in-out property <bool> show-setup;
    callback setup-mode(int);
    callback decline-disclaimer();
    callback set-start-with-windows(bool);
    callback set-context-menu(bool);
    callback set-updates(int);
    callback set-close-action(int);
    callback set-game-info(bool);
    callback set-hold(int);
    callback set-delay(int);
    callback set-hotkeys(bool);
    // 0 HDR on or off, 1 mode, 2 pause; the text as typed.
    callback set-shortcut(int, string);
    callback set-log-titles(bool);
    callback set-notify-failures(bool);
    callback set-battery-sdr(bool);

    HorizontalLayout {
        // Navigation pane; an icon rail in the compact layout.
        // Up and Down change the page while the pane has the keyboard.
        nav := FocusScope {
            property <bool> keyboard;
            width: root.compact ? 64px : root.wide ? 240px : 200px;
            focus-gained(reason) => {
                self.keyboard = reason == FocusReason.tab-navigation;
            }
            key-pressed(event) => {
                if event.text == Key.UpArrow && root.page > 0 {
                    root.page -= 1;
                    self.keyboard = true;
                    return accept;
                }
                if event.text == Key.DownArrow && root.page < 4 {
                    root.page += 1;
                    self.keyboard = true;
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding: 8px;
                padding-top: 14px;
                spacing: 4px;
                // The state at a glance: the icon fades between gray and
                // color as HDR turns off and on.
                HorizontalLayout {
                    height: 52px;
                    padding-left: root.compact ? 0px : 12px;
                    padding-right: root.compact ? 0px : 8px;
                    spacing: 12px;
                    alignment: root.compact ? center : stretch;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        Image {
                            source: Theme.logo-sdr;
                            width: parent.width;
                            height: parent.height;
                            opacity: root.hdr-on ? 0 : 1;
                            animate opacity { duration: Theme.fade; easing: ease-in-out; }
                            accessible-role: none;
                        }
                        Image {
                            source: Theme.logo-hdr;
                            width: parent.width;
                            height: parent.height;
                            opacity: root.hdr-on ? 1 : 0;
                            animate opacity { duration: Theme.fade; easing: ease-in-out; }
                            accessible-role: none;
                        }
                    }
                    if !root.compact: VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.hdr-on ? "HDR on" : "HDR off";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: root.nav-detail;
                            font-size: Theme.caption-size;
                            color: Theme.text-muted;
                            overflow: elide;
                        }
                    }
                }
                for item[i] in [
                    { glyph: "\u{E80F}", label: "Status" },
                    { glyph: "\u{E7FC}", label: "Games" },
                    { glyph: "\u{E714}", label: "Video players" },
                    { glyph: "\u{E7F4}", label: "Displays" },
                ]: NavItem {
                    glyph: item.glyph;
                    label: item.label;
                    compact: root.compact;
                    selected: root.page == i;
                    keyboard-focus: nav.has-focus && nav.keyboard;
                    activate => {
                        root.page = i;
                        nav.focus();
                        nav.keyboard = false;
                    }
                }
                // Settings describes Huedra itself, so it is pinned at the
                // foot of the pane, as NavigationView does in Windows 11.
                Rectangle {
                    vertical-stretch: 1;
                }
                NavItem {
                    glyph: "\u{E713}";
                    label: "Settings";
                    compact: root.compact;
                    selected: root.page == 4;
                    keyboard-focus: nav.has-focus && nav.keyboard;
                    activate => {
                        root.page = 4;
                        nav.focus();
                        nav.keyboard = false;
                    }
                }
            }
        }

        // Pages cross-fade and rise 8 px when the page changes. With Mica
        // the pages sit on the same backdrop as the navigation pane.
        Rectangle {
            horizontal-stretch: 1;
            background: root.mica ? transparent : Theme.background;
            status := StatusPage {
                property <bool> active: root.page == 0;
                opacity: active ? 1 : 0;
                y: active ? 0px : 8px;
                visible: self.opacity > 0.01;
                animate opacity, y { duration: Theme.page; easing: ease-out; }
                tray-running: root.tray-running;
                hdr-on: root.hdr-on;
                headline: root.headline;
                detail: root.detail;
                caption: root.caption;
                mode: root.mode;
                paused: root.paused;
                pause-note: root.pause-note;
                history: root.history;
                now: root.now;
                idle: root.idle;
                displays: root.status-displays;
                hotkeys: root.hotkeys;
                mode-keys: root.keys-mode;
                pause-keys: root.keys-pause;
                failure: root.failure;
                update-version: root.update-bar-closed ? "" : root.install-version;
                version: root.version;
                set-mode(i) => {
                    root.set-mode(i);
                }
                open-game(id) => {
                    root.page = 1;
                    root.select-game(id);
                }
                open-page(p) => {
                    root.page = p;
                }
                close-failure => {
                    root.close-failure();
                }
                new-look: root.new-look;
                new-look-setup => {
                    root.close-new-look();
                    root.show-setup = true;
                }
                close-new-look => {
                    root.close-new-look();
                }
                show-update => {
                    root.show-update = true;
                }
                close-update => {
                    root.update-bar-closed = true;
                }
                toggle-pause => {
                    root.toggle-pause();
                }
                start-huedra => {
                    root.start-huedra();
                }
            }
            GamesPage {
                property <bool> active: root.page == 1;
                opacity: active ? 1 : 0;
                y: active ? 0px : 8px;
                visible: self.opacity > 0.01;
                animate opacity, y { duration: Theme.page; easing: ease-out; }
                wide: root.wide;
                games: root.games;
                chips: root.chips;
                cue-chips: root.cue-chips;
                suggest-count: root.suggest-count;
                grid <=> root.games-grid;
                filter: root.filter;
                total: root.game-total;
                details: root.details;
                selected-id: root.selected-id;
                scan-note: root.scan-note;
                search-changed(t) => {
                    root.search-changed(t);
                }
                filter-changed(k) => {
                    root.filter-changed(k);
                }
                select-game(id) => {
                    root.select-game(id);
                }
                close-detail => {
                    root.close-detail();
                }
                add-game => {
                    root.add-game();
                }
                rescan => {
                    root.rescan();
                }
                apply-all-suggestions => {
                    root.apply-all-suggestions();
                }
                grid-shown => {
                    root.games-grid-shown();
                }
                set-setting(id, i) => {
                    root.set-game-setting(id, i);
                }
                set-delay(id, v) => {
                    root.set-game-delay(id, v);
                }
                set-hold(id, v) => {
                    root.set-game-hold(id, v);
                }
                reset-timing(id) => {
                    root.reset-game-timing(id);
                }
                apply-suggestion(id) => {
                    root.apply-suggestion(id);
                }
                open-wiki(url) => {
                    root.open-wiki(url);
                }
                remove-game(id) => {
                    root.remove-game(id);
                }
                create-shortcut(id) => {
                    root.create-shortcut(id);
                }
                set-steam-start(id, on) => {
                    root.set-game-steam-start(id, on);
                }
                sdr-profiles: root.sdr-profiles;
                hdr-profiles: root.hdr-profiles;
                set-profile(id, hdr, i) => {
                    root.set-game-profile(id, hdr, i);
                }
                set-auto-hdr(id, i) => {
                    root.set-game-auto-hdr(id, i);
                }
                display-modes: root.display-modes;
                set-display-mode(id, i) => {
                    root.set-game-display-mode(id, i);
                }
            }
            VideoPage {
                property <bool> active: root.page == 2;
                opacity: active ? 1 : 0;
                y: active ? 0px : 8px;
                visible: self.opacity > 0.01;
                animate opacity, y { duration: Theme.page; easing: ease-out; }
                players: root.video-players;
                browsers: root.video-browsers;
                keywords: root.video-keywords;
                full-screen-only: root.video-full-screen-only;
                sdr-with-rtx: root.video-sdr-with-rtx;
                rtx-note: root.video-rtx-note;
                sites: root.video-sites;
                hold: root.video-hold-custom ? root.video-hold : root.hold;
                hold-custom: root.video-hold-custom;
                default-hold: root.hold;
                set-app(key, i) => {
                    root.set-video-app(key, i);
                }
                set-keywords(text) => {
                    root.set-video-keywords(text);
                }
                set-full-screen-only(on) => {
                    root.set-video-full-screen-only(on);
                }
                set-sdr-with-rtx(on) => {
                    root.set-video-sdr-with-rtx(on);
                }
                set-site(key, on) => {
                    root.set-video-site(key, on);
                }
                open-extension => {
                    root.open-extension();
                }
                set-hold(v) => {
                    root.set-video-hold(v);
                }
                reset-hold => {
                    root.reset-video-hold();
                }
            }
            DisplaysPage {
                property <bool> active: root.page == 3;
                opacity: active ? 1 : 0;
                y: active ? 0px : 8px;
                visible: self.opacity > 0.01;
                animate opacity, y { duration: Theme.page; easing: ease-out; }
                displays: root.displays;
                retries: root.retries;
                content-only: root.content-only;
                main-only: root.main-only;
                set-main-only(on) => {
                    root.set-main-only(on);
                }
                set-controlled(id, on) => {
                    root.set-controlled(id, on);
                }
                set-brightness(id, v) => {
                    root.set-brightness(id, v);
                }
                set-content-only(on) => {
                    root.set-content-only(on);
                }
                set-retries(n) => {
                    root.set-retries(n);
                }
            }
            SettingsPage {
                property <bool> active: root.page == 4;
                opacity: active ? 1 : 0;
                y: active ? 0px : 8px;
                visible: self.opacity > 0.01;
                animate opacity, y { duration: Theme.page; easing: ease-out; }
                hdr-on: root.hdr-on;
                start-with-windows: root.start-with-windows;
                context-menu: root.context-menu;
                updates: root.updates;
                close-action: root.close-action;
                game-info: root.game-info;
                hold: root.hold;
                delay: root.delay;
                hotkeys: root.hotkeys;
                keys-hdr: root.keys-hdr;
                keys-mode: root.keys-mode;
                keys-pause: root.keys-pause;
                shortcut-error: root.shortcut-error;
                shortcut-note: root.shortcut-note;
                log-titles: root.log-titles;
                notify-failures: root.notify-failures;
                battery-sdr: root.battery-sdr;
                version: root.version;
                data-folder: root.data-folder;
                update-note: root.update-note;
                can-check-updates: root.can-check-updates;
                checking-updates: root.checking-updates;
                update-check-status: root.update-check-status;
                update-version: root.update-bar-closed ? "" : root.install-version;
                has-project-page: root.has-project-page;
                check-updates => {
                    root.check-updates();
                }
                show-update => {
                    root.show-update = true;
                }
                close-update => {
                    root.update-bar-closed = true;
                }
                open-project => {
                    root.open-project();
                }
                open-support => {
                    root.open-support();
                }
                show-disclaimer => {
                    root.show-disclaimer = true;
                }
                set-start-with-windows(on) => {
                    root.set-start-with-windows(on);
                }
                set-context-menu(on) => {
                    root.set-context-menu(on);
                }
                set-updates(i) => {
                    root.set-updates(i);
                }
                set-close-action(i) => {
                    root.set-close-action(i);
                }
                set-game-info(on) => {
                    root.set-game-info(on);
                }
                set-hold(v) => {
                    root.set-hold(v);
                }
                set-delay(v) => {
                    root.set-delay(v);
                }
                set-hotkeys(on) => {
                    root.set-hotkeys(on);
                }
                set-shortcut(i, text) => {
                    root.set-shortcut(i, text);
                }
                set-log-titles(on) => {
                    root.set-log-titles(on);
                }
                set-notify-failures(on) => {
                    root.set-notify-failures(on);
                }
                set-battery-sdr(on) => {
                    root.set-battery-sdr(on);
                }
            }
        }
    }

    // The disclaimer, over everything else.
    if root.show-disclaimer: Rectangle {
        background: #000000a0;
        TouchArea {
            // Takes the clicks meant for the window behind.
        }
        Rectangle {
            width: min(parent.width - 48px, 620px);
            height: min(parent.height - 48px, card.preferred-height);
            border-radius: Theme.radius-card;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000060;
            card := VerticalLayout {
                padding: 28px;
                spacing: 14px;
                Text {
                    text: "Before you start";
                    font-size: Theme.heading-size;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: "Huedra turns Windows HDR on for games and HDR video, and off again afterward. It changes only the HDR switch in Settings > System > Display.";
                    wrap: word-wrap;
                    color: Theme.text;
                }
                Text {
                    text: "Huedra is provided \"as is\", without warranty of any kind, and you use it at your own risk. Its authors and contributors are not liable for any damage, data loss or other problem with your computer, displays, games or other software that may result from using it, including a display left in HDR or SDR after an interrupted switch.";
                    wrap: word-wrap;
                    color: Theme.text;
                }
                Text {
                    text: "Huedra does not read or change the memory of other programs. No game publisher has reviewed it, and how anti-cheat software treats it cannot be guaranteed.";
                    wrap: word-wrap;
                    color: Theme.text;
                }
                Text {
                    text: "If a display gets stuck in HDR, turn it off in Settings > System > Display, or run: huedra hdr off --display all";
                    wrap: word-wrap;
                    color: Theme.text-muted;
                    font-size: Theme.caption-size;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding-top: 6px;
                    if !root.disclaimer-accepted: ActionButton {
                        text: "Exit";
                        clicked => {
                            root.decline-disclaimer();
                        }
                    }
                    accept := ActionButton {
                        text: root.disclaimer-accepted ? "Close" : "Accept and continue";
                        primary: true;
                        clicked => {
                            root.accept-disclaimer();
                        }
                    }
                }
            }
            init => {
                accept.focus();
            }
        }
    }
    // First-run setup, over the pages.
    if root.show-setup && !root.show-disclaimer: Rectangle {
        background: #000000a0;
        TouchArea {
            // Takes the clicks meant for the window behind.
        }
        SetupPage {
            width: min(parent.width - 48px, 720px);
            height: min(parent.height - 48px, 640px);
            displays: root.displays;
            games: root.games;
            chips: root.chips;
            total: root.game-total;
            game-info: root.game-info;
            mode: root.mode;
            mode-keys: root.hotkeys ? root.keys-mode : "";
            start-with-windows: root.start-with-windows;
            set-controlled(id, on) => {
                root.set-controlled(id, on);
            }
            set-game-info(on) => {
                root.set-game-info(on);
            }
            set-mode(i) => {
                root.setup-mode(i);
            }
            set-start-with-windows(on) => {
                root.set-start-with-windows(on);
            }
            done => {
                root.show-setup = false;
            }
        }
    }
    // The update dialog, over everything but the disclaimer.
    if root.show-update && !root.show-disclaimer && !root.show-setup: Rectangle {
        background: #000000a0;
        TouchArea {
            // Takes the clicks meant for the window behind.
        }
        Rectangle {
            width: min(parent.width - 48px, 560px);
            height: min(parent.height - 48px, update-card.preferred-height);
            border-radius: Theme.radius-card;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000060;
            clip: true;
            update-card := VerticalLayout {
                padding: 28px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    Image {
                        width: 28px;
                        height: 28px;
                        source: Theme.logo-hdr;
                        accessible-role: none;
                    }
                    Text {
                        text: "Update available";
                        font-size: Theme.heading-size;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "Huedra " + root.update-version + " is ready to install. You have version " + root.version + ".";
                    wrap: word-wrap;
                    color: Theme.text;
                }
                if root.update-notes.length > 0: Text {
                    text: "What's new";
                    font-weight: 600;
                    color: Theme.text;
                }
                // The list scrolls when the window is too low for it, so
                // the buttons below always stay in view.
                // (A Flickable rather than a ScrollView: the Fluent scroll
                // bars would add some 20 KB to the program.)
                if root.update-notes.length > 0: Flickable {
                    vertical-stretch: 1;
                    min-height: 72px;
                    preferred-height: notes-list.preferred-height;
                    content-width: self.width;
                    content-height: max(self.height, notes-list.preferred-height);
                    notes-list := VerticalLayout {
                        width: parent.width;
                        spacing: 6px;
                        alignment: start;
                        for note in root.update-notes: HorizontalLayout {
                            spacing: note.heading ? 0px : 8px;
                            padding-top: note.heading ? 4px : 0px;
                            padding-right: 12px;
                            Text {
                                text: note.heading ? "" : "\u{2022}";
                                width: note.heading ? 0px : 10px;
                                color: Theme.text-muted;
                                accessible-role: none;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: note.text;
                                wrap: word-wrap;
                                font-size: note.heading ? Theme.caption-size : Theme.body-size;
                                font-weight: note.heading ? 600 : 400;
                                color: note.heading ? Theme.text-muted : Theme.text;
                            }
                        }
                    }
                }
                if root.update-notes.length == 0 || root.update-more > 0: Text {
                    text: root.update-notes.length == 0
                        ? "The list of changes is in the changelog."
                        : "And " + root.update-more + (root.update-more == 1 ? " more change." : " more changes.");
                    wrap: word-wrap;
                    color: Theme.text-muted;
                }
                if root.update-status != "": Text {
                    text: root.update-status;
                    wrap: word-wrap;
                    color: Theme.text-muted;
                    font-size: Theme.caption-size;
                }
                HorizontalLayout {
                    spacing: 8px;
                    padding-top: 8px;
                    if root.has-changelog: ActionButton {
                        text: "See the full changelog";
                        clicked => {
                            root.open-changelog();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    ActionButton {
                        text: "Later";
                        enabled: !root.installing-update;
                        clicked => {
                            root.show-update = false;
                        }
                    }
                    install-button := ActionButton {
                        text: root.installing-update ? "Installing..." : "Download and install";
                        primary: true;
                        enabled: !root.installing-update;
                        clicked => {
                            root.install-update();
                        }
                    }
                }
            }
            init => {
                install-button.focus();
            }
        }
    }
}
