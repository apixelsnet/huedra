// The four pages of the settings window and the parts they share.
// Feature doc: docs/features/08-settings-window.md

import { ScrollView, ListView, AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    FocusRing, Toggle, ActionButton, SearchBox, NumberBox, Dropdown, CopyField, TextBox,
    IconButton, LinkButton, KeyCap, FilterChip, InfoBar, Expander, SubRow
} from "controls.slint";

export struct GameRow {
    id: string,
    name: string,
    icon: image,
    initial: string,
    // The store, or "Running · Steam" while it runs.
    store: string,
    // HDR support from PCGamingWiki: hdr, limited, no, mod, unknown,
    // pending (not looked up yet), or empty while game information is off.
    hdr: string,
    // Its HDR setting; "Default" unless the game has its own.
    setting: string,
    own: bool,
    // The suggested setting where it differs from the current one.
    suggestion: string,
    running: bool,
    // 0 to 5: the tint of its tile in the cover grid.
    tint: int,
    // Portrait art for the grid (Steam's library image), or none.
    cover: image,
}

// What holds HDR now: a game, a video player, or nothing (kind "none").
export struct NowRow {
    kind: string,
    id: string,
    name: string,
    icon: image,
    initial: string,
    detail: string,
}

export struct GameDetail {
    id: string,
    name: string,
    icon: image,
    initial: string,
    store: string,
    path: string,
    setting-index: int,
    delay: int,
    hold: int,
    custom-timing: bool,
    manual: bool,
    looked-up: bool,
    info: string,
    notes: string,
    ray-tracing: string,
    wiki-url: string,
    suggestion: string,
    suggestion-index: int,
    // Steam launch option for Launch with HDR; empty for other stores.
    launch-option: string,
    // Whether HDR turns on when Steam starts it (Steam games only).
    steam-start: bool,
    // Whether a desktop shortcut can start it with HDR (its program is known).
    shortcut: bool,
    // Result of the last shortcut made for it.
    launch-note: string,
}

export struct DisplayRow {
    id: string,
    number: int,
    title: string,
    detail: string,
    capable: bool,
    // Huedra may change HDR on it ("Let Huedra control HDR").
    controlled: bool,
    hdr-on: bool,
    // The line under its name on Status: "Main display · Controlled by Huedra".
    status: string,
}

export struct VideoAppRow {
    key: string,
    name: string,
    choices: [string],
    index: int,
    active: bool,
}

export struct SiteRow {
    key: string,
    name: string,
    address: string,
    on: bool,
}

export struct HistoryRow {
    // The day heading ("Today") on the first change of each day, else empty.
    group: string,
    time: string,
    title: string,
    detail: string,
    kind: string,
}

// One line of the update dialog's list of changes.
export struct UpdateNote {
    heading: bool,
    text: string,
}

export struct StoreChip {
    key: string,
    label: string,
    count: int,
}

// ---- Shared parts -----------------------------------------------------

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
}

component PageTitle inherits Text {
    font-size: Theme.title-size;
    font-weight: 600;
    color: Theme.text;
    accessible-role: text;
}

component SectionTitle inherits Text {
    font-size: 16px;
    font-weight: 600;
    color: Theme.text;
}

component Caption inherits Text {
    font-size: Theme.caption-size;
    color: Theme.text-muted;
    wrap: word-wrap;
}

// Centers its children vertically without capping the row it sits in. A
// row is never taller than the smallest maximum height among its parts, and
// fixed-height controls have one, so wrapped text beside them was cut off.
component Centered inherits VerticalLayout {
    Rectangle {
        vertical-stretch: 1;
    }
    @children
    Rectangle {
        vertical-stretch: 1;
    }
}

// A game's icon, or its first letter on a tinted square while it has none.
component GameIcon inherits Rectangle {
    in property <image> icon;
    in property <string> initial;
    in property <length> size: 32px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 5;
    clip: true;
    background: root.icon.width > 0 ? transparent : Theme.surface-raised;
    accessible-role: none;
    if root.icon.width > 0: Image {
        width: parent.width;
        height: parent.height;
        source: root.icon;
        image-fit: contain;
    }
    if root.icon.width == 0: Text {
        text: root.initial;
        font-size: root.size * 0.45;
        font-weight: 600;
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SettingRow inherits Card {
    in property <string> title;
    in property <string> description;
    min-height: 64px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: Theme.body-size;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.description != "": Caption {
                text: root.description;
            }
        }
        Centered {
            horizontal-stretch: 0;
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                @children
            }
        }
    }
}

// A pill label. Kinds: hdr (pink), sdr (gray), external and suggestion
// (violet), failed (pink outline), out (outline only, for "not recorded").
component Badge inherits Rectangle {
    in property <string> text;
    in property <string> kind;
    in property <bool> dot;
    height: 22px;
    width: layout.preferred-width;
    border-radius: 11px;
    background: kind == "hdr" ? #FF2D6F26 : kind == "external" || kind == "suggestion" ? #9B3DFF26
        : kind == "failed" ? #FF2D6F14 : kind == "out" ? transparent : #A9A4B633;
    border-width: kind == "failed" || kind == "out" ? 1px : 0px;
    border-color: kind == "out" ? Theme.border : Theme.hdr-label;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    layout := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: label.color;
            }
        }
        label := Text {
            text: root.text;
            font-size: Theme.caption-size;
            font-weight: kind == "out" ? 400 : 600;
            color: kind == "hdr" || kind == "failed" ? Theme.hdr-label
                : kind == "external" || kind == "suggestion" ? Theme.violet-text : Theme.text-muted;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The HDR support badge of a game, from GameRow.hdr.
component HdrBadge inherits Badge {
    in property <string> support;
    kind: support == "hdr" || support == "limited" ? "hdr" : support == "no" ? "sdr"
        : support == "mod" ? "suggestion" : "out";
    text: support == "hdr" ? "HDR" : support == "limited" ? "Limited HDR" : support == "no" ? "No HDR"
        : support == "mod" ? "HDR mod" : support == "pending" ? "Looking up" : "Not recorded";
}

// A tile on a dashboard card: raised, with an icon, two lines and an
// action on the right.
component Tile inherits Rectangle {
    min-height: 56px;
    border-radius: Theme.radius-control + 2px;
    background: Theme.surface-raised;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        @children
    }
}

// The two lines of text in a tile or row.
component TwoLines inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    in property <bool> bold;
    horizontal-stretch: 1;
    alignment: center;
    spacing: 2px;
    Text {
        text: root.title;
        font-size: Theme.body-size;
        font-weight: root.bold ? 600 : 400;
        color: Theme.text;
        wrap: word-wrap;
    }
    if root.text != "": Text {
        text: root.text;
        font-size: Theme.caption-size;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}

// A three-way segmented control for the mode; Left and Right change it.
export component ModeSelector inherits Rectangle {
    in property <int> mode;
    callback chosen(int);
    height: Theme.button-height + 4px;
    border-radius: Theme.radius-control + 2px;
    background: Theme.surface-raised;
    forward-focus: focus;
    accessible-role: tab-list;
    accessible-label: "Mode";
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for label[i] in ["Automatic", "Always HDR", "Always SDR"]: Rectangle {
            property <bool> selected: root.mode == i;
            border-radius: Theme.radius-control;
            background: selected ? Theme.accent : touch.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.control; }
            accessible-role: tab;
            accessible-label: label;
            accessible-item-selected: selected;
            accessible-action-default => {
                root.chosen(i);
            }
            Text {
                text: label;
                font-size: Theme.body-size;
                font-weight: selected ? 600 : 400;
                color: selected ? Theme.on-accent : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            touch := TouchArea {
                clicked => {
                    root.chosen(i);
                }
            }
        }
    }
    focus := FocusScope {
        x: 0;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.LeftArrow && root.mode > 0 {
                root.chosen(root.mode - 1);
                return accept;
            }
            if event.text == Key.RightArrow && root.mode < 2 {
                root.chosen(root.mode + 1);
                return accept;
            }
            reject
        }
    }
    if focus.has-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.border-radius + 3px;
    }
}

// The status card with its color chart: the BT.2020 triangle around the
// sRGB triangle. Gray in SDR; while HDR is on the spectrum fades into the
// chart and the card over Theme.fade (400 ms), and back to gray in SDR.
component HeroCard inherits Rectangle {
    in property <bool> hdr-on;
    in property <string> headline;
    in property <string> detail;
    in property <string> caption;
    min-height: 140px;
    border-radius: Theme.radius-card;
    background: Theme.surface;
    border-width: 1px;
    border-color: root.hdr-on ? Theme.violet : Theme.border;
    animate border-color { duration: Theme.fade; easing: ease-in-out; }
    clip: true;
    Image {
        source: Theme.spectrum-image;
        image-fit: fill;
        width: parent.width;
        height: parent.height;
        opacity: root.hdr-on ? (Theme.dark ? 0.3 : 0.22) : 0;
        animate opacity { duration: Theme.fade; easing: ease-in-out; }
        accessible-role: none;
    }
    HorizontalLayout {
        padding: 22px;
        spacing: 22px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 84px;
                height: 84px;
                Image {
                    source: Theme.chart-sdr;
                    width: parent.width;
                    height: parent.height;
                    opacity: root.hdr-on ? 0 : 1;
                    animate opacity { duration: Theme.fade; easing: ease-in-out; }
                    accessible-role: none;
                }
                Image {
                    source: Theme.chart-hdr;
                    width: parent.width;
                    height: parent.height;
                    opacity: root.hdr-on ? 1 : 0;
                    animate opacity { duration: Theme.fade; easing: ease-in-out; }
                    accessible-role: none;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            alignment: center;
            Text {
                text: root.headline;
                font-size: Theme.title-size;
                font-weight: 600;
                color: root.hdr-on ? Theme.pink : Theme.text;
                animate color { duration: Theme.fade; }
            }
            Text {
                text: root.detail;
                font-size: Theme.body-size;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                text: root.caption;
                font-size: Theme.caption-size;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }
}

// ---- Status -----------------------------------------------------------

// The game or player that holds HDR, with a link to its settings.
component NowCard inherits Card {
    in property <[NowRow]> now;
    in property <string> idle;
    callback open-game(string);
    callback open-video();
    VerticalLayout {
        padding: 16px;
        padding-top: 14px;
        spacing: 10px;
        alignment: start;
        SectionTitle {
            text: "Now running";
        }
        if root.now.length == 0: Tile {
            Centered {
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Theme.radius-control;
                    background: Theme.border;
                    Text {
                        text: "–";
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            TwoLines {
                title: "No game or HDR video";
                text: root.idle;
            }
        }
        for item in root.now: Tile {
            Centered {
                if item.kind == "game": GameIcon {
                    icon: item.icon;
                    initial: item.initial;
                }
                if item.kind != "game": Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Theme.radius-control;
                    background: #3341E640;
                    Text {
                        text: "\u{E714}";
                        font-family: Theme.icons;
                        font-size: 16px;
                        color: Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            TwoLines {
                title: item.name;
                text: item.detail;
                bold: true;
            }
            if item.kind == "game" || item.kind == "video": Centered {
                LinkButton {
                    text: item.kind == "game" ? "Game settings" : "Player settings";
                    clicked => {
                        if item.kind == "game" {
                            root.open-game(item.id);
                        } else {
                            root.open-video();
                        }
                    }
                }
            }
        }
    }
}

// Each display's state and whether Huedra controls it.
component DisplaysCard inherits Card {
    in property <[DisplayRow]> displays;
    callback open-displays();
    VerticalLayout {
        padding: 16px;
        padding-top: 14px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            SectionTitle {
                horizontal-stretch: 1;
                text: "Displays";
                vertical-alignment: center;
            }
            LinkButton {
                text: "Display settings";
                clicked => {
                    root.open-displays();
                }
            }
        }
        if root.displays.length == 0: Caption {
            text: "No display was found.";
        }
        for d in root.displays: Tile {
            Centered {
                Text {
                    width: 20px;
                    text: "\u{E7F4}";
                    font-family: Theme.icons;
                    font-size: 16px;
                    color: Theme.text;
                    horizontal-alignment: center;
                    accessible-role: none;
                }
            }
            TwoLines {
                title: d.title;
                text: d.status;
            }
            if d.capable: Centered {
                Badge {
                    kind: d.hdr-on ? "hdr" : "sdr";
                    text: d.hdr-on ? "HDR" : "SDR";
                }
            }
        }
    }
}

export component StatusPage inherits Rectangle {
    in property <bool> tray-running;
    in property <bool> hdr-on;
    in property <string> headline;
    in property <string> detail;
    in property <string> caption;
    in property <int> mode;
    in property <bool> paused;
    in property <string> pause-note;
    in property <[HistoryRow]> history;
    in property <[NowRow]> now;
    in property <string> idle;
    in property <[DisplayRow]> displays;
    in property <bool> hotkeys;
    // The newest failed switch, until closed.
    in property <string> failure;
    // A newer version waiting, until closed.
    in property <string> update-version;
    in property <string> version;
    callback set-mode(int);
    callback toggle-pause();
    callback start-huedra();
    callback open-game(string);
    callback open-page(int);
    callback close-failure();
    callback show-update();
    callback close-update();

    // How many changes show before "Show earlier changes".
    property <int> history-limit: 5;
    property <bool> all-history;
    // The two cards sit side by side when there is room.
    property <bool> two-columns: true;
    changed width => {
        root.two-columns = min(root.width, Theme.page-width) >= 760px;
    }
    init => {
        root.two-columns = min(root.width, Theme.page-width) >= 760px;
    }

    page := ScrollView {
        // At least the preferred height, so rows keep their wrapped text
        // when the page is taller than the window (the default is the
        // minimum height, which squeezes them). Setting one size drops the
        // default for the other, so the width is set as well.
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            width: min(page.visible-width, Theme.page-width);
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            PageTitle {
                text: "Status";
            }
            if !root.tray-running: InfoBar {
                kind: "info";
                title: "Huedra isn't running.";
                text: "HDR won't switch on its own until it starts.";
                ActionButton {
                    text: "Start Huedra";
                    primary: true;
                    clicked => {
                        root.start-huedra();
                    }
                }
            }
            if root.failure != "": InfoBar {
                kind: "error";
                title: "HDR didn't switch.";
                text: root.failure + " Recent changes and the log have the details.";
                closable: true;
                closed => {
                    root.close-failure();
                }
            }
            if root.update-version != "": InfoBar {
                kind: "update";
                title: "Huedra " + root.update-version + " is available.";
                text: "You have " + root.version + ".";
                closable: true;
                ActionButton {
                    text: "See what's new";
                    clicked => {
                        root.show-update();
                    }
                }
                closed => {
                    root.close-update();
                }
            }
            HeroCard {
                hdr-on: root.hdr-on;
                headline: root.headline;
                detail: root.detail;
                caption: root.caption;
            }
            if root.two-columns: HorizontalLayout {
                spacing: Theme.gap;
                // Equal halves whatever they hold.
                NowCard {
                    width: (min(page.visible-width, Theme.page-width) - 2 * Theme.page-padding - Theme.gap) / 2;
                    now: root.now;
                    idle: root.idle;
                    open-game(id) => {
                        root.open-game(id);
                    }
                    open-video => {
                        root.open-page(2);
                    }
                }
                DisplaysCard {
                    width: (min(page.visible-width, Theme.page-width) - 2 * Theme.page-padding - Theme.gap) / 2;
                    displays: root.displays;
                    open-displays => {
                        root.open-page(3);
                    }
                }
            }
            if !root.two-columns: NowCard {
                now: root.now;
                idle: root.idle;
                open-game(id) => {
                    root.open-game(id);
                }
                open-video => {
                    root.open-page(2);
                }
            }
            if !root.two-columns: DisplaysCard {
                displays: root.displays;
                open-displays => {
                    root.open-page(3);
                }
            }
            // Mode, with Pause as its own row at the foot of the card.
            Card {
                VerticalLayout {
                    VerticalLayout {
                        padding: 16px;
                        padding-top: 14px;
                        spacing: 10px;
                        SectionTitle {
                            text: "Mode";
                        }
                        ModeSelector {
                            mode: root.mode;
                            chosen(i) => {
                                root.set-mode(i);
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Caption {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                text: "Automatic: HDR turns on for games and HDR video, then off again. Always HDR and Always SDR stay until you change them.";
                            }
                            if root.hotkeys: Centered {
                                KeyCap {
                                    text: "Win+Alt+O";
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 16px;
                        min-height: 60px;
                        TwoLines {
                            title: "Pause automatic switching";
                            text: root.paused ? root.pause-note : "HDR stays as it is now for one hour.";
                        }
                        if root.hotkeys: Centered {
                            KeyCap {
                                text: "Win+Alt+P";
                            }
                        }
                        Centered {
                            ActionButton {
                                text: root.paused ? "Resume" : "Pause for 1 hour";
                                enabled: root.tray-running;
                                clicked => {
                                    root.toggle-pause();
                                }
                            }
                        }
                    }
                }
            }
            SectionTitle {
                text: "Recent changes";
            }
            if root.history.length == 0: Caption {
                text: root.tray-running ? "No changes since Huedra started." : "Shown while Huedra is running.";
            }
            if root.history.length > 0: Card {
                VerticalLayout {
                    padding-bottom: 4px;
                    for entry[i] in root.history: VerticalLayout {
                        if (i < root.history-limit || root.all-history) && entry.group != "": HorizontalLayout {
                            padding-left: 14px;
                            padding-top: 10px;
                            Text {
                                text: entry.group;
                                font-size: Theme.caption-size;
                                font-weight: 600;
                                color: Theme.text-muted;
                            }
                        }
                        if (i < root.history-limit || root.all-history) && entry.group == "" && i > 0: Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        if i < root.history-limit || root.all-history: HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 14px;
                            Text {
                                text: entry.time;
                                font-size: Theme.caption-size;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                width: 48px;
                            }
                            TwoLines {
                                title: entry.title;
                                text: entry.detail;
                                bold: true;
                            }
                            Centered {
                                Badge {
                                    kind: entry.kind;
                                    text: entry.kind == "hdr" ? "HDR" : entry.kind == "external" ? "External" : entry.kind == "failed" ? "Failed" : "SDR";
                                }
                            }
                        }
                    }
                    if root.history.length > root.history-limit: VerticalLayout {
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        HorizontalLayout {
                            padding-left: 76px;
                            padding-top: 4px;
                            alignment: start;
                            LinkButton {
                                text: root.all-history ? "Show fewer"
                                    : "Show " + (root.history.length - root.history-limit) + " earlier "
                                    + (root.history.length - root.history-limit == 1 ? "change" : "changes");
                                clicked => {
                                    root.all-history = !root.all-history;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---- Games ------------------------------------------------------------

component GameDetailPanel inherits Card {
    in property <GameDetail> detail;
    in property <bool> show-back;
    callback back();
    callback set-setting(string, int);
    callback set-delay(string, int);
    callback set-hold(string, int);
    callback reset-timing(string);
    callback apply-suggestion(string);
    callback open-wiki(string);
    callback remove-game(string);
    callback create-shortcut(string);
    callback set-steam-start(string, bool);

    ScrollView {
        // At least the preferred height, so rows keep their wrapped text
        // when the page is taller than the window (the default is the
        // minimum height, which squeezes them). Setting one size drops the
        // default for the other, so the width is set as well.
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            alignment: start;
            if root.show-back: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Back to games";
                    clicked => {
                        root.back();
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Centered {
                    GameIcon {
                        size: 40px;
                        icon: root.detail.icon;
                        initial: root.detail.initial;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.detail.name;
                    font-size: Theme.heading-size;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                // Beside the list the pane closes here; on narrow layouts
                // "Back to games" does it.
                if !root.show-back: Centered {
                    IconButton {
                        glyph: "\u{E711}";
                        label: "Close " + root.detail.name;
                        clicked => {
                            root.back();
                        }
                    }
                }
            }
            Caption {
                text: root.detail.store + " · " + root.detail.path;
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "When this game runs";
                    font-size: Theme.body-size;
                    color: Theme.text;
                }
                Dropdown {
                    accessible-label: "When this game runs";
                    model: ["Turn HDR on", "Leave HDR alone", "Let the game switch HDR"];
                    current-index: root.detail.setting-index;
                    selected(value) => {
                        root.set-setting(root.detail.id, self.current-index);
                    }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Wait before turning HDR on (seconds)";
                        font-size: Theme.body-size;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    NumberBox {
                        accessible-label: "Wait before turning HDR on (seconds)";
                        minimum: 0;
                        maximum: 120;
                        value: root.detail.delay;
                        edited(v) => {
                            root.set-delay(root.detail.id, v);
                        }
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Keep HDR on after the game closes (seconds)";
                        font-size: Theme.body-size;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    NumberBox {
                        accessible-label: "Keep HDR on after the game closes (seconds)";
                        minimum: 0;
                        maximum: 600;
                        value: root.detail.hold;
                        edited(v) => {
                            root.set-hold(root.detail.id, v);
                        }
                    }
                }
            }
            if root.detail.custom-timing: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Reset to default times";
                    clicked => {
                        root.reset-timing(root.detail.id);
                    }
                }
            }
            if root.detail.launch-option != "" || root.detail.shortcut: Rectangle {
                height: 1px;
                background: Theme.border;
            }
            if root.detail.launch-option != "" || root.detail.shortcut: SectionTitle {
                text: "Turn HDR on before the game starts";
            }
            if root.detail.launch-option != "" || root.detail.shortcut: Caption {
                text: "For games that need HDR on before they open, such as ones that otherwise gray out their HDR option. HDR stays on until the game closes.";
            }
            if root.detail.launch-option != "": HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: "Turn HDR on when I press Play in Steam";
                        font-size: Theme.body-size;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    Caption {
                        text: "HDR turns on about a second after you press Play, before the game opens. Huedra only reads what Steam reports and never touches the game, so it suits games with anti-cheat.";
                    }
                }
                Centered {
                    horizontal-stretch: 0;
                    Toggle {
                        accessible-label: "Turn HDR on when I press Play in Steam";
                        checked: root.detail.steam-start;
                        toggled => {
                            root.set-steam-start(root.detail.id, self.checked);
                        }
                    }
                }
            }
            if root.detail.launch-option != "": VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Another way: paste this into Steam › the game's Properties › General › Launch options. Some anti-cheat games won't start this way.";
                    font-size: Theme.body-size;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                CopyField {
                    text: root.detail.launch-option;
                    label: "Steam launch option";
                }
            }
            if root.detail.shortcut: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Create a desktop shortcut";
                    clicked => {
                        root.create-shortcut(root.detail.id);
                    }
                }
            }
            if root.detail.launch-note != "": Caption {
                text: root.detail.launch-note;
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            SectionTitle {
                text: "From PCGamingWiki";
            }
            Text {
                text: root.detail.info;
                font-size: Theme.body-size;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.detail.notes != "": Caption {
                text: "\"" + root.detail.notes + "\"";
            }
            if root.detail.ray-tracing != "": Caption {
                text: "Ray tracing: " + root.detail.ray-tracing;
            }
            if root.detail.suggestion != "" && root.detail.suggestion-index != root.detail.setting-index: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Use the suggested setting: " + root.detail.suggestion;
                    clicked => {
                        root.apply-suggestion(root.detail.id);
                    }
                }
            }
            if root.detail.wiki-url != "": HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Open the PCGamingWiki page";
                    clicked => {
                        root.open-wiki(root.detail.wiki-url);
                    }
                }
            }
            if root.detail.looked-up: Caption {
                text: "From PCGamingWiki (CC BY-NC-SA 3.0). Huedra never changes a setting on its own.";
            }
            if root.detail.manual: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Remove this game";
                    clicked => {
                        root.remove-game(root.detail.id);
                    }
                }
            }
        }
    }
}

// The tint behind a game's tile in the cover grid.
component CoverTint inherits Rectangle {
    in property <int> tint;
    background: tint == 0 ? #9B3DFF40 : tint == 1 ? #3341E640 : tint == 2 ? #00C8F033
        : tint == 3 ? #14D98A33 : tint == 4 ? #FF2D6F33 : #A9A4B640;
}

// The store filters of the Games page.
component StoreChips inherits HorizontalLayout {
    in property <[StoreChip]> chips;
    in property <string> filter;
    callback chosen(string);
    spacing: 6px;
    alignment: start;
    for chip in root.chips: FilterChip {
        text: chip.label;
        count: chip.count;
        selected: root.filter == chip.key;
        clicked => {
            root.chosen(chip.key);
        }
    }
}

// The filters by what the Games list shows: Supports HDR, Own setting,
// Suggestions.
component CueChips inherits HorizontalLayout {
    in property <[StoreChip]> chips;
    in property <string> filter;
    callback chosen(string);
    spacing: 6px;
    alignment: start;
    for chip in root.chips: FilterChip {
        text: chip.label;
        count: chip.count;
        selected: root.filter == chip.key;
        has-dot: chip.key == "hdr" || chip.key == "suggest";
        dot: chip.key == "hdr" ? Theme.hdr-label : Theme.violet-text;
        clicked => {
            root.chosen(chip.key);
        }
    }
}

export component GamesPage inherits Rectangle {
    in property <bool> wide;
    in property <[GameRow]> games;
    in property <[StoreChip]> chips;
    // Filters by what the list shows: Supports HDR, Own setting, Suggestions.
    in property <[StoreChip]> cue-chips;
    in property <string> filter;
    in property <int> total;
    in property <int> suggest-count;
    // The selected game, as a list of zero or one entries: a new list makes a
    // fresh detail panel (another game, or values changed from outside the
    // controls); the same game is updated in place and keeps the focus.
    in property <[GameDetail]> details;
    in property <string> selected-id;
    in property <string> scan-note;
    // The cover grid instead of the list.
    in-out property <bool> grid;
    callback search-changed(string);
    callback filter-changed(string);
    callback select-game(string);
    callback close-detail();
    callback add-game();
    callback rescan();
    callback apply-all-suggestions();
    // The grid was shown: its art can be loaded.
    callback grid-shown();
    changed grid => {
        if root.grid {
            root.grid-shown();
        }
    }
    callback set-setting(string, int);
    callback set-delay(string, int);
    callback set-hold(string, int);
    callback reset-timing(string);
    callback apply-suggestion(string);
    callback open-wiki(string);
    callback remove-game(string);
    callback create-shortcut(string);
    callback set-steam-start(string, bool);

    property <bool> has-selection: root.details.length > 0;
    property <bool> list-visible: root.wide || !root.has-selection;
    property <length> row-height: 56px;
    property <bool> suggest-closed;
    // The row the keyboard is on, and whether the keyboard put it there.
    property <int> cursor: 0;
    property <bool> keyboard;
    // Which columns fit; set when the width changes (see SettingsWindow).
    property <bool> show-support: true;
    property <bool> show-setting: true;
    property <bool> chips-wrap: false;
    // The cover grid's columns and tile size.
    property <length> grid-gap: 14px;
    property <int> columns: 4;
    property <length> tile-width: 120px;
    property <length> tile-height: self.tile-width * 1.5 + 28px;

    function fit() {
        let page = min(root.width, Theme.page-width);
        root.show-support = root.has-selection ? page >= 1000px : page >= 560px;
        root.show-setting = !root.has-selection && page >= 820px;
        root.chips-wrap = page < 1000px;
    }
    changed width => {
        root.fit();
    }
    changed has-selection => {
        root.fit();
    }
    init => {
        root.fit();
    }

    function move-cursor(index: int) {
        root.cursor = max(0, min(index, root.games.length - 1));
        root.keyboard = true;
    }

    column := VerticalLayout {
        width: min(root.width, Theme.page-width);
        padding: Theme.page-padding;
        padding-bottom: 16px;
        spacing: Theme.gap;
        PageTitle {
            text: "Games";
        }
        HorizontalLayout {
            spacing: 8px;
            SearchBox {
                horizontal-stretch: 1;
                placeholder: "Search " + root.total + " games";
                edited(text) => {
                    root.search-changed(text);
                }
            }
            ActionButton {
                text: "Add game";
                clicked => {
                    root.add-game();
                }
            }
            ActionButton {
                text: "Find new games";
                clicked => {
                    root.rescan();
                }
            }
            Rectangle {
                width: 70px;
                height: Theme.button-height;
                border-radius: Theme.radius-control + 2px;
                background: Theme.surface-raised;
                accessible-role: tab-list;
                accessible-label: "View";
                HorizontalLayout {
                    padding: 1px;
                    spacing: 2px;
                    IconButton {
                        width: 33px;
                        height: 30px;
                        glyph: "\u{E8FD}";
                        label: "List";
                        selected: !root.grid;
                        clicked => {
                            root.grid = false;
                        }
                    }
                    IconButton {
                        width: 33px;
                        height: 30px;
                        glyph: "\u{F0E2}";
                        label: "Cover grid";
                        selected: root.grid;
                        clicked => {
                            root.grid = true;
                        }
                    }
                }
            }
        }
        // The filters: stores, then what the list shows. On narrow pages
        // the second group takes its own row.
        if !root.chips-wrap: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            StoreChips {
                chips: root.chips;
                filter: root.filter;
                chosen(key) => {
                    root.filter-changed(key);
                }
            }
            if root.cue-chips.length > 0: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 9px;
                    height: 18px;
                    Rectangle {
                        x: 4px;
                        width: 1px;
                        background: Theme.border;
                    }
                }
            }
            CueChips {
                chips: root.cue-chips;
                filter: root.filter;
                chosen(key) => {
                    root.filter-changed(key);
                }
            }
        }
        if root.chips-wrap: StoreChips {
            chips: root.chips;
            filter: root.filter;
            chosen(key) => {
                root.filter-changed(key);
            }
        }
        if root.chips-wrap: CueChips {
            chips: root.cue-chips;
            filter: root.filter;
            chosen(key) => {
                root.filter-changed(key);
            }
        }
        if root.suggest-count > 0 && !root.suggest-closed: InfoBar {
            kind: "info";
            title: root.suggest-count == 1 ? "1 game has a different suggestion." : root.suggest-count + " games have a different suggestion.";
            text: "PCGamingWiki's HDR support points to another setting for them. Suggestions are never applied on their own.";
            closable: true;
            if root.filter != "suggest": ActionButton {
                text: "Review";
                clicked => {
                    root.filter-changed("suggest");
                }
            }
            ActionButton {
                text: root.suggest-count == 1 ? "Apply it" : "Apply all " + root.suggest-count;
                primary: true;
                clicked => {
                    root.apply-all-suggestions();
                }
            }
            closed => {
                root.suggest-closed = true;
            }
        }
        if root.scan-note != "": Caption {
            text: root.scan-note;
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.gap;
            if root.list-visible: Card {
                horizontal-stretch: 3;
                // Up, Down, Home and End move through the list (in the grid
                // Left and Right as well); Enter or Space opens the game.
                // Clicking a row also gives the list the keyboard.
                list-keys := FocusScope {
                    x: 0;
                    width: 0px;
                    focus-gained(reason) => {
                        root.cursor = min(max(root.cursor, 0), root.games.length - 1);
                        root.keyboard = reason == FocusReason.tab-navigation;
                    }
                    key-pressed(event) => {
                        if root.games.length == 0 {
                            return reject;
                        }
                        let step = root.grid ? root.columns : 1;
                        if event.text == Key.DownArrow {
                            root.move-cursor(root.cursor + step);
                            return accept;
                        }
                        if event.text == Key.UpArrow {
                            root.move-cursor(root.cursor - step);
                            return accept;
                        }
                        if root.grid && event.text == Key.RightArrow {
                            root.move-cursor(root.cursor + 1);
                            return accept;
                        }
                        if root.grid && event.text == Key.LeftArrow {
                            root.move-cursor(root.cursor - 1);
                            return accept;
                        }
                        if event.text == Key.Home {
                            root.move-cursor(0);
                            return accept;
                        }
                        if event.text == Key.End {
                            root.move-cursor(root.games.length - 1);
                            return accept;
                        }
                        if (event.text == Key.Space || event.text == Key.Return) && root.cursor >= 0 && root.cursor < root.games.length {
                            root.keyboard = true;
                            root.select-game(root.games[root.cursor].id);
                            return accept;
                        }
                        reject
                    }
                }
                if !root.grid: VerticalLayout {
                    if root.show-support: HorizontalLayout {
                        height: 32px;
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        Rectangle {
                            width: 32px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Game";
                            font-size: Theme.caption-size;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        Text {
                            width: 130px;
                            text: "HDR support";
                            font-size: Theme.caption-size;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        if root.show-setting: Text {
                            width: 250px;
                            text: "Setting";
                            font-size: Theme.caption-size;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                    if root.show-support: Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    ListView {
                        vertical-stretch: 1;
                        accessible-label: "Games";
                        // Scrolls just enough to keep the keyboard row in view.
                        property <int> cursor: root.cursor;
                        changed cursor => {
                            let top = self.cursor * root.row-height;
                            if top < -self.content-y {
                                self.content-y = -top;
                            } else if top + root.row-height > self.visible-height - self.content-y {
                                self.content-y = self.visible-height - top - root.row-height;
                            }
                        }
                        for game[i] in root.games: Rectangle {
                            property <bool> selected: root.has-selection && root.selected-id == game.id;
                            height: root.row-height;
                            background: selected ? Theme.surface-raised : row-touch.has-hover ? Theme.hover : transparent;
                            animate background { duration: Theme.hover-time; }
                            accessible-role: list-item;
                            accessible-label: game.name;
                            accessible-description: game.setting;
                            accessible-item-selected: selected;
                            accessible-action-default => {
                                root.select-game(game.id);
                            }
                            if i > 0: Rectangle {
                                y: 0;
                                height: 1px;
                                background: Theme.border;
                            }
                            Rectangle {
                                x: 0;
                                width: 3px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 2px;
                                background: selected ? Theme.accent : transparent;
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                Centered {
                                    GameIcon {
                                        icon: game.icon;
                                        initial: game.initial;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: game.name;
                                        font-size: Theme.body-size;
                                        font-weight: game.running ? 600 : 500;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: game.store;
                                        font-size: Theme.caption-size;
                                        color: game.running ? Theme.hdr-label : Theme.text-muted;
                                        overflow: elide;
                                    }
                                }
                                if root.show-support: Rectangle {
                                    width: 130px;
                                    if game.hdr != "": HdrBadge {
                                        x: 0;
                                        support: game.hdr;
                                    }
                                }
                                if root.show-setting: HorizontalLayout {
                                    width: 250px;
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: game.setting;
                                        font-size: Theme.caption-size;
                                        font-weight: game.own ? 600 : 400;
                                        color: game.own ? Theme.text : Theme.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if game.suggestion != "": Centered {
                                        Badge {
                                            kind: "suggestion";
                                            dot: true;
                                            text: "Suggests " + game.suggestion;
                                        }
                                    }
                                    if game.suggestion == "" && game.own: Text {
                                        text: "Own setting";
                                        font-size: 11px;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            row-touch := TouchArea {
                                clicked => {
                                    root.cursor = i;
                                    list-keys.focus();
                                    root.keyboard = false;
                                    root.select-game(game.id);
                                }
                            }
                            if list-keys.has-focus && root.keyboard && root.cursor == i: FocusRing {
                                width: parent.width;
                                height: parent.height;
                                border-radius: Theme.radius-control;
                            }
                        }
                    }
                }
                if root.grid: Flickable {
                    property <length> area: self.width - 2 * root.grid-gap;
                    property <int> cursor: root.cursor;
                    changed area => {
                        root.columns = max(2, floor((self.area + root.grid-gap) / (128px + root.grid-gap)));
                        root.tile-width = (self.area - (root.columns - 1) * root.grid-gap) / root.columns;
                    }
                    init => {
                        root.columns = max(2, floor((self.area + root.grid-gap) / (128px + root.grid-gap)));
                        root.tile-width = (self.area - (root.columns - 1) * root.grid-gap) / root.columns;
                    }
                    // Scrolls just enough to keep the keyboard tile in view.
                    changed cursor => {
                        let top = floor(self.cursor / root.columns) * (root.tile-height + root.grid-gap);
                        if top < -self.content-y {
                            self.content-y = -top;
                        } else if top + root.tile-height + 2 * root.grid-gap > self.height - self.content-y {
                            self.content-y = self.height - top - root.tile-height - 2 * root.grid-gap;
                        }
                    }
                    content-width: self.width;
                    content-height: max(self.height, ceil(root.games.length / root.columns) * (root.tile-height + root.grid-gap) + root.grid-gap);
                    for game[i] in root.games: Rectangle {
                        property <bool> selected: root.has-selection && root.selected-id == game.id;
                        x: root.grid-gap + mod(i, root.columns) * (root.tile-width + root.grid-gap);
                        y: root.grid-gap + floor(i / root.columns) * (root.tile-height + root.grid-gap);
                        width: root.tile-width;
                        height: root.tile-height;
                        accessible-role: list-item;
                        accessible-label: game.name;
                        accessible-description: game.setting;
                        accessible-item-selected: selected;
                        accessible-action-default => {
                            root.select-game(game.id);
                        }
                        CoverTint {
                            y: 0;
                            height: root.tile-width * 1.5;
                            border-radius: Theme.radius-card - 2px;
                            border-width: selected ? 2px : 0px;
                            border-color: Theme.accent;
                            tint: game.tint;
                            clip: true;
                            if game.cover.width > 0: Image {
                                width: parent.width;
                                height: parent.height;
                                source: game.cover;
                                image-fit: cover;
                                accessible-role: none;
                            }
                            Rectangle {
                                background: tile-touch.has-hover ? #FFFFFF14 : transparent;
                                border-radius: parent.border-radius;
                            }
                            if game.cover.width == 0: GameIcon {
                                size: min(64px, parent.width / 2);
                                icon: game.icon;
                                initial: game.initial;
                            }
                            if game.hdr == "hdr" || game.hdr == "limited": HdrBadge {
                                x: 6px;
                                y: 6px;
                                support: game.hdr;
                            }
                            if game.suggestion != "": Rectangle {
                                x: parent.width - 16px;
                                y: 9px;
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: Theme.violet-text;
                            }
                        }
                        Text {
                            y: root.tile-width * 1.5 + 6px;
                            height: 20px;
                            width: parent.width;
                            text: game.name;
                            font-size: 13px;
                            font-weight: game.running ? 600 : 400;
                            color: Theme.text;
                            overflow: elide;
                        }
                        tile-touch := TouchArea {
                            clicked => {
                                root.cursor = i;
                                list-keys.focus();
                                root.keyboard = false;
                                root.select-game(game.id);
                            }
                        }
                        if list-keys.has-focus && root.keyboard && root.cursor == i: FocusRing {
                            x: -3px;
                            y: -3px;
                            width: parent.width + 6px;
                            height: root.tile-width * 1.5 + 6px;
                            border-radius: Theme.radius-card + 1px;
                        }
                    }
                }
                if root.games.length == 0: Caption {
                    x: 16px;
                    y: root.show-support && !root.grid ? 49px : 16px;
                    width: parent.width - 32px;
                    text: root.total == 0 ? "No games were found. Add game picks a program by hand." : "No game matches.";
                }
            }
            for detail in root.details: GameDetailPanel {
                horizontal-stretch: 2;
                min-width: 300px;
                detail: detail;
                show-back: !root.wide;
                back => {
                    root.close-detail();
                }
                set-setting(id, i) => {
                    root.set-setting(id, i);
                }
                set-delay(id, v) => {
                    root.set-delay(id, v);
                }
                set-hold(id, v) => {
                    root.set-hold(id, v);
                }
                reset-timing(id) => {
                    root.reset-timing(id);
                }
                apply-suggestion(id) => {
                    root.apply-suggestion(id);
                }
                open-wiki(url) => {
                    root.open-wiki(url);
                }
                remove-game(id) => {
                    root.remove-game(id);
                }
                create-shortcut(id) => {
                    root.create-shortcut(id);
                }
                set-steam-start(id, on) => {
                    root.set-steam-start(id, on);
                }
            }
        }
    }
}

// ---- Video players ----------------------------------------------------

// One program in a list card: its name and what Huedra does for it.
component VideoAppLine inherits HorizontalLayout {
    in property <VideoAppRow> app;
    callback chosen(int);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text {
            text: root.app.name;
            font-size: Theme.body-size;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.app.active: Caption {
            text: "HDR on now";
        }
    }
    Centered {
        horizontal-stretch: 0;
        Dropdown {
            width: 220px;
            accessible-label: root.app.name;
            model: root.app.choices;
            current-index: root.app.index;
            selected(value) => {
                root.chosen(self.current-index);
            }
        }
    }
}

// A card listing programs, with a line between them.
component VideoAppList inherits Card {
    in property <[VideoAppRow]> apps;
    callback chosen(string, int);
    VerticalLayout {
        for app[i] in root.apps: VerticalLayout {
            if i > 0: Rectangle {
                height: 1px;
                background: Theme.border;
            }
            VideoAppLine {
                app: app;
                chosen(index) => {
                    root.chosen(app.key, index);
                }
            }
        }
    }
}

export component VideoPage inherits Rectangle {
    in property <[VideoAppRow]> players;
    in property <[VideoAppRow]> browsers;
    in property <string> keywords;
    in property <bool> full-screen-only;
    in property <bool> sdr-with-rtx;
    in property <string> rtx-note;
    in property <[SiteRow]> sites;
    in property <int> hold;
    in property <bool> hold-custom;
    in property <int> default-hold;
    callback set-app(string, int);
    callback set-keywords(string);
    callback set-full-screen-only(bool);
    callback set-sdr-with-rtx(bool);
    callback set-site(string, bool);
    callback set-hold(int);
    callback reset-hold();
    callback open-extension();

    page := ScrollView {
        // At least the preferred height, so rows keep their wrapped text
        // when the page is taller than the window (the default is the
        // minimum height, which squeezes them). Setting one size drops the
        // default for the other, so the width is set as well.
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            width: min(page.visible-width, Theme.page-width);
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            PageTitle {
                text: "Video players";
            }
            Caption {
                text: "HDR turns on when a player opens a video whose file name has one of the words below. It turns off a few seconds after that video stops.";
            }
            // The field takes the card's width: the words do not fit beside
            // the description in narrow layouts.
            Card {
                VerticalLayout {
                    padding: 16px;
                    padding-top: 12px;
                    spacing: 2px;
                    Text {
                        text: "HDR words in file names";
                        font-size: Theme.body-size;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    Caption {
                        text: "Separate words with commas and press Enter. Only whole words match; capitals, dots, dashes and underscores don't matter. Leave empty to use the defaults.";
                    }
                    Rectangle {
                        height: 8px;
                    }
                    TextBox {
                        value: root.keywords;
                        label: "HDR words in file names";
                        accepted(text) => {
                            root.set-keywords(text);
                        }
                    }
                }
            }
            SettingRow {
                title: "Only in full screen";
                description: "Videos in a window don't switch HDR.";
                Toggle {
                    accessible-label: "Only in full screen";
                    checked: root.full-screen-only;
                    toggled => {
                        root.set-full-screen-only(self.checked);
                    }
                }
            }
            SettingRow {
                title: "Regular video with RTX Video HDR";
                description: root.rtx-note;
                Toggle {
                    accessible-label: "Regular video with RTX Video HDR";
                    checked: root.sdr-with-rtx;
                    toggled => {
                        root.set-sdr-with-rtx(self.checked);
                    }
                }
            }
            SettingRow {
                title: "Keep HDR on after the video ends (seconds)";
                description: "Stops the screen flickering off and on between episodes. " + (root.hold-custom ? "Replaces the " + root.default-hold + " seconds set under Settings › Timing." : "Uses the time set under Settings › Timing.");
                if root.hold-custom: ActionButton {
                    text: "Use the default";
                    clicked => {
                        root.reset-hold();
                    }
                }
                NumberBox {
                    accessible-label: "Keep HDR on after the video ends (seconds)";
                    minimum: 0;
                    maximum: 600;
                    value: root.hold;
                    edited(v) => {
                        root.set-hold(v);
                    }
                }
            }
            SectionTitle {
                text: "Players";
            }
            VideoAppList {
                apps: root.players;
                chosen(key, index) => {
                    root.set-app(key, index);
                }
            }
            SectionTitle {
                text: "Browsers";
            }
            Caption {
                text: "Browsers switch HDR only through the Huedra browser extension. It turns HDR on for HDR videos on YouTube and for full-screen video on the streaming sites you turn on below. With Regular video with RTX Video HDR on, any full-screen video with sound counts too.";
            }
            SettingRow {
                title: "Huedra browser extension";
                description: "For Chrome, Edge, Brave, Opera and Vivaldi, from the Chrome Web Store. For Firefox, see the setup guide.";
                Centered {
                    ActionButton {
                        primary: true;
                        text: "Get the extension";
                        clicked => {
                            root.open-extension();
                        }
                    }
                }
            }
            VideoAppList {
                apps: root.browsers;
                chosen(key, index) => {
                    root.set-app(key, index);
                }
            }
            SectionTitle {
                text: "Streaming sites";
            }
            Caption {
                text: "These sites don't say whether a video is HDR. Turn a site on only if it plays HDR in your browser; then any full-screen video there turns HDR on.";
            }
            for site in root.sites: SettingRow {
                title: site.name;
                description: site.address;
                Toggle {
                    accessible-label: site.name;
                    checked: site.on;
                    toggled => {
                        root.set-site(site.key, self.checked);
                    }
                }
            }
        }
    }
}

// ---- First-run setup --------------------------------------------------

// A choice among the modes, as a card with a round mark.
component ModeCard inherits Card {
    in property <string> title;
    in property <string> text;
    in property <bool> selected;
    in property <bool> recommended;
    callback chosen();
    border-color: root.selected ? Theme.accent : Theme.border;
    border-width: root.selected ? 2px : 1px;
    min-height: 64px;
    forward-focus: keys;
    accessible-role: radio-button;
    accessible-label: root.title;
    accessible-description: root.text;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.chosen();
    }
    touch := TouchArea {
        clicked => {
            root.chosen();
        }
    }
    keys := FocusScope {
        x: 0;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.chosen();
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        padding: 14px;
        padding-left: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: root.selected ? 5px : 1px;
                border-color: root.selected ? Theme.accent : Theme.text-muted;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.title;
                    font-weight: 600;
                    color: Theme.text;
                }
                if root.recommended: Rectangle {
                    height: 18px;
                    width: rec.preferred-width + 10px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    rec := Text {
                        text: "Recommended";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Caption {
                text: root.text;
            }
        }
    }
    if keys.has-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius-card + 3px;
    }
}

// Three short screens after the disclaimer is accepted for the first time:
// which displays Huedra controls, the games it found, and the mode. Each
// choice is saved at once; Skip setup keeps the defaults.
export component SetupPage inherits Rectangle {
    in property <[DisplayRow]> displays;
    in property <[GameRow]> games;
    in property <[StoreChip]> chips;
    in property <int> total;
    in property <bool> game-info;
    in property <int> mode;
    in property <bool> start-with-windows;
    callback set-controlled(string, bool);
    callback set-game-info(bool);
    callback set-mode(int);
    callback set-start-with-windows(bool);
    callback done();

    property <int> step: 0;
    // "Steam, Xbox and GOG": the stores that found games.
    property <string> stores: root.chips.length <= 1 ? "your launchers"
        : root.chips.length == 2 ? root.chips[1].label
        : root.chips.length == 3 ? root.chips[1].label + " and " + root.chips[2].label
        : root.chips[1].label + ", " + root.chips[2].label + " and " + (root.chips.length - 3 == 1 ? root.chips[3].label : "others");

    background: Theme.background;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 1;
            padding: 28px;
            padding-top: 22px;
            spacing: 10px;
            alignment: start;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for i in 3: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 4px;
                        border-radius: 2px;
                        background: i <= root.step ? Theme.accent : Theme.border;
                    }
                }
                Text {
                    text: "Step " + (root.step + 1) + " of 3";
                    font-size: Theme.caption-size;
                    color: Theme.text-muted;
                }
            }
            PageTitle {
                text: root.step == 0 ? "Choose your displays" : root.step == 1 ? "Your games" : "Choose a mode";
            }
            if root.step == 0: Caption {
                text: "Huedra changes HDR only on the displays you choose. You can change this later in Displays.";
            }
            if root.step == 0: VerticalLayout {
                spacing: 8px;
                for d in root.displays: Card {
                    min-height: 60px;
                    HorizontalLayout {
                        padding: 12px;
                        padding-left: 16px;
                        spacing: 14px;
                        TwoLines {
                            title: d.title;
                            text: d.capable ? "Supports HDR" : "No HDR support";
                            bold: true;
                        }
                        if d.capable: Centered {
                            Toggle {
                                text: "Let Huedra control HDR";
                                spoken-text: "Let Huedra control HDR on " + d.title;
                                checked: d.controlled;
                                toggled => {
                                    root.set-controlled(d.id, self.checked);
                                }
                            }
                        }
                        if !d.capable: Centered {
                            Caption {
                                text: "Not available";
                            }
                        }
                    }
                }
            }
            if root.step == 1: Caption {
                text: root.total == 0
                    ? "Huedra found no games yet. Games installed later are found when Huedra starts, and Add game on the Games page picks any program."
                    : "Huedra found " + root.total + (root.total == 1 ? " game" : " games") + " in " + root.stores + ". HDR turns on while each one runs. You can change any game later in Games.";
            }
            if root.step == 1 && root.total > 0: Card {
                VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;
                    for game[i] in root.games: VerticalLayout {
                        if i < 3 && i > 0: Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        if i < 3: HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 12px;
                            Centered {
                                GameIcon {
                                    icon: game.icon;
                                    initial: game.initial;
                                }
                            }
                            TwoLines {
                                title: game.name;
                                text: game.store;
                            }
                            if game.hdr != "": Centered {
                                HdrBadge {
                                    support: game.hdr;
                                }
                            }
                        }
                    }
                    if root.total > 3: HorizontalLayout {
                        padding-left: 16px;
                        height: 30px;
                        Caption {
                            vertical-alignment: center;
                            text: "And " + (root.total - 3) + " more on the Games page.";
                        }
                    }
                }
            }
            if root.step == 1: SettingRow {
                title: "Look up HDR support on PCGamingWiki";
                description: "Sends the Steam ID or the name of each game to pcgamingwiki.com to learn which games support HDR, and looks up icons in Discord's public list. You can change this later in Settings › Advanced.";
                Toggle {
                    accessible-label: "Look up HDR support on PCGamingWiki";
                    checked: root.game-info;
                    toggled => {
                        root.set-game-info(self.checked);
                    }
                }
            }
            if root.step == 2: Caption {
                text: "You can change the mode at any time from the tray icon, the Status page or Win+Alt+O.";
            }
            if root.step == 2: VerticalLayout {
                spacing: 8px;
                ModeCard {
                    title: "Automatic";
                    text: "HDR turns on for games and HDR video, and off when they end.";
                    recommended: true;
                    selected: root.mode == 0;
                    chosen => {
                        root.set-mode(0);
                    }
                }
                ModeCard {
                    title: "Always HDR";
                    text: "HDR stays on, on the main display or every display Huedra controls.";
                    selected: root.mode == 1;
                    chosen => {
                        root.set-mode(1);
                    }
                }
                ModeCard {
                    title: "Always SDR";
                    text: "HDR stays off.";
                    selected: root.mode == 2;
                    chosen => {
                        root.set-mode(2);
                    }
                }
            }
            if root.step == 2: SettingRow {
                title: "Start with Windows";
                description: "Huedra starts quietly in the tray when you sign in.";
                Toggle {
                    accessible-label: "Start with Windows";
                    checked: root.start-with-windows;
                    toggled => {
                        root.set-start-with-windows(self.checked);
                    }
                }
            }
        }
        Rectangle {
            height: 60px;
            background: Theme.surface;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                spacing: 8px;
                Centered {
                    ActionButton {
                        text: "Skip setup";
                        clicked => {
                            root.done();
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.step > 0: Centered {
                    ActionButton {
                        text: "Back";
                        clicked => {
                            root.step -= 1;
                        }
                    }
                }
                Centered {
                    next := ActionButton {
                        min-width: 96px;
                        text: root.step < 2 ? "Next" : "Done";
                        primary: true;
                        clicked => {
                            if root.step < 2 {
                                root.step += 1;
                            } else {
                                root.done();
                            }
                        }
                    }
                }
            }
        }
    }
    init => {
        next.focus();
    }
}

// ---- Displays ---------------------------------------------------------

export component DisplaysPage inherits Rectangle {
    in property <[DisplayRow]> displays;
    in property <int> retries;
    in property <bool> content-only;
    in property <bool> main-only;
    callback set-controlled(string, bool);
    callback set-retries(int);
    callback set-content-only(bool);
    callback set-main-only(bool);

    page := ScrollView {
        // At least the preferred height, so rows keep their wrapped text
        // when the page is taller than the window (the default is the
        // minimum height, which squeezes them). Setting one size drops the
        // default for the other, so the width is set as well.
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            width: min(page.visible-width, Theme.page-width);
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            PageTitle {
                text: "Displays";
            }
            Caption {
                text: "Huedra switches only the displays it controls. New HDR displays are controlled automatically.";
            }
            for d in root.displays: Card {
                HorizontalLayout {
                    padding: 16px;
                    spacing: 14px;
                    Centered {
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: Theme.radius-control;
                            clip: true;
                            background: Theme.surface-raised;
                            if d.hdr-on: Image {
                                source: Theme.spectrum-image;
                                image-fit: fill;
                                width: parent.width;
                                height: parent.height;
                            }
                            Text {
                                text: d.number;
                                font-size: 16px;
                                font-weight: 600;
                                color: d.hdr-on ? #FFFFFF : Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: d.title;
                            font-size: Theme.body-size;
                            font-weight: 600;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Caption {
                            text: d.detail;
                        }
                    }
                    if d.capable: Centered {
                        Toggle {
                            text: "Let Huedra control HDR";
                            spoken-text: "Let Huedra control HDR on " + d.title;
                            checked: d.controlled;
                            toggled => {
                                root.set-controlled(d.id, self.checked);
                            }
                        }
                    }
                    if !d.capable: Centered {
                        Caption {
                            text: "Not available";
                        }
                    }
                }
            }
            SectionTitle {
                text: "How displays switch";
            }
            SettingRow {
                title: "Switch only the display with the game or video";
                description: "HDR turns on only where the game or video is, and follows the window if you move it. Off: all displays switch together.";
                Toggle {
                    accessible-label: "Switch only the display with the game or video";
                    checked: root.content-only;
                    toggled => {
                        root.set-content-only(self.checked);
                    }
                }
            }
            SettingRow {
                title: "Always HDR on the main display only";
                description: "Always HDR and the shortcut turn HDR on only for your main display. Off: all displays.";
                Toggle {
                    accessible-label: "Always HDR on the main display only";
                    checked: root.main-only;
                    toggled => {
                        root.set-main-only(self.checked);
                    }
                }
            }
            SettingRow {
                title: "Retries when a switch fails";
                description: "Some displays ignore the first try while the screen changes mode.";
                NumberBox {
                    accessible-label: "Retries when a switch fails";
                    minimum: 0;
                    maximum: 5;
                    value: root.retries;
                    edited(v) => {
                        root.set-retries(v);
                    }
                }
            }
        }
    }
}

// ---- Settings ---------------------------------------------------------

export component SettingsPage inherits Rectangle {
    in property <bool> hdr-on;
    in property <bool> start-with-windows;
    in property <bool> context-menu;
    in property <int> updates;
    in property <int> close-action;
    in property <bool> game-info;
    in property <int> hold;
    in property <int> delay;
    in property <bool> hotkeys;
    in property <string> hotkey-note;
    in property <bool> log-titles;
    in property <bool> notify-failures;
    in property <string> version;
    in property <string> data-folder;
    in property <string> update-note;
    in property <bool> can-check-updates;
    in property <bool> checking-updates;
    // What Check for updates found, shown in About's header.
    in property <string> update-check-status;
    // A newer version waiting, until closed.
    in property <string> update-version;
    in property <bool> has-project-page;
    callback check-updates();
    callback show-update();
    callback close-update();
    callback open-project();
    callback open-support();
    callback show-disclaimer();
    callback set-start-with-windows(bool);
    callback set-context-menu(bool);
    callback set-updates(int);
    callback set-close-action(int);
    callback set-game-info(bool);
    callback set-hold(int);
    callback set-delay(int);
    callback set-hotkeys(bool);
    callback set-log-titles(bool);
    callback set-notify-failures(bool);

    page := ScrollView {
        // At least the preferred height, so rows keep their wrapped text
        // when the page is taller than the window (the default is the
        // minimum height, which squeezes them). Setting one size drops the
        // default for the other, so the width is set as well.
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            width: min(page.visible-width, Theme.page-width);
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            PageTitle {
                text: "Settings";
            }
            if root.update-version != "": InfoBar {
                kind: "update";
                title: "Huedra " + root.update-version + " is available.";
                text: "You have " + root.version + ".";
                closable: true;
                ActionButton {
                    text: "See what's new";
                    clicked => {
                        root.show-update();
                    }
                }
                closed => {
                    root.close-update();
                }
            }
            SettingRow {
                title: "Start with Windows";
                description: "Starts quietly in the tray.";
                Toggle {
                    accessible-label: "Start with Windows";
                    checked: root.start-with-windows;
                    toggled => {
                        root.set-start-with-windows(self.checked);
                    }
                }
            }
            SettingRow {
                title: "Closing this window";
                description: "Keep Huedra running: HDR keeps switching from the tray. Quit Huedra: closing the window closes Huedra and turns HDR back off. Exit in the tray menu always quits.";
                Dropdown {
                    accessible-label: "Closing this window";
                    model: ["Keep Huedra running", "Quit Huedra"];
                    current-index: root.close-action;
                    selected(value) => {
                        root.set-close-action(self.current-index);
                    }
                }
            }
            SettingRow {
                title: "Notify me when HDR doesn't switch";
                description: "Only when a switch fails after Huedra's retries. Normal switches never notify. During a full-screen game, Windows may hold it in the notification center.";
                Toggle {
                    accessible-label: "Notify me when HDR doesn't switch";
                    checked: root.notify-failures;
                    toggled => {
                        root.set-notify-failures(self.checked);
                    }
                }
            }
            SettingRow {
                title: "Updates";
                description: "Checks once a day for a new signed release. Ask before installing: you choose when. Install automatically: installs when no game or video is running. Your settings are kept." + (root.update-note != "" ? " " + root.update-note : "");
                Dropdown {
                    accessible-label: "Updates";
                    model: ["Install automatically", "Ask before installing", "Off"];
                    current-index: root.updates;
                    selected(value) => {
                        root.set-updates(self.current-index);
                    }
                }
            }
            Expander {
                glyph: "\u{E823}";
                title: "Timing";
                summary: "Keep HDR on " + root.hold + " s after a game or video ends · "
                    + (root.delay == 0 ? "no wait before turning HDR on" : "wait " + root.delay + " s before turning HDR on");
                SubRow {
                    first: true;
                    title: "Keep HDR on after a game or video ends (seconds)";
                    description: "Stops the screen flickering off and on when you restart a game or play the next video. Games and video players can set their own time.";
                    NumberBox {
                        accessible-label: "Keep HDR on after a game or video ends (seconds)";
                        minimum: 0;
                        maximum: 600;
                        value: root.hold;
                        edited(v) => {
                            root.set-hold(v);
                        }
                    }
                }
                SubRow {
                    title: "Default wait before turning HDR on (seconds)";
                    description: "For games that don't set their own.";
                    NumberBox {
                        accessible-label: "Default wait before turning HDR on (seconds)";
                        minimum: 0;
                        maximum: 120;
                        value: root.delay;
                        edited(v) => {
                            root.set-delay(v);
                        }
                    }
                }
            }
            Expander {
                glyph: "\u{E765}";
                title: "Keyboard shortcuts";
                summary: root.hotkeys
                    ? "Win+Alt+H turns HDR on or off · Win+Alt+O changes the mode · Win+Alt+P pauses or resumes"
                    : "Off";
                has-toggle: true;
                toggle-checked: root.hotkeys;
                toggled(on) => {
                    root.set-hotkeys(on);
                }
                SubRow {
                    first: true;
                    description: "Win+Alt+H turns HDR on or off now. Win+Alt+O steps through Automatic, Always HDR and Always SDR. Win+Alt+P pauses switching for an hour, or resumes it." + (root.hotkey-note != "" ? " " + root.hotkey-note : "");
                }
            }
            Expander {
                glyph: "\u{E9E9}";
                title: "Advanced";
                summary: "\"Start with HDR\" in the right-click menu: " + (root.context-menu ? "on" : "off")
                    + " · tab and file names in the log: " + (root.log-titles ? "on" : "off")
                    + " · game information: " + (root.game-info ? "on" : "off");
                SubRow {
                    first: true;
                    title: "Add \"Start with HDR\" to the right-click menu";
                    description: "Right-click a program in File Explorer › Show more options › Start with HDR. HDR stays on until the program closes.";
                    Toggle {
                        accessible-label: "Add \"Start with HDR\" to the right-click menu";
                        checked: root.context-menu;
                        toggled => {
                            root.set-context-menu(self.checked);
                        }
                    }
                }
                SubRow {
                    title: "Write tab and file names to the log";
                    description: "Turn off to keep them out of the log.";
                    Toggle {
                        accessible-label: "Write tab and file names to the log";
                        checked: root.log-titles;
                        toggled => {
                            root.set-log-titles(self.checked);
                        }
                    }
                }
                SubRow {
                    title: "Game information and icons";
                    description: "Gets HDR details from PCGamingWiki and icons from Discord's public game list. Only the game's name or Steam ID is sent. Results are saved for 30 days. When off, icons come from the games themselves.";
                    Toggle {
                        accessible-label: "Game information and icons";
                        checked: root.game-info;
                        toggled => {
                            root.set-game-info(self.checked);
                        }
                    }
                }
            }
            Expander {
                logo: true;
                hdr: root.hdr-on;
                title: "Huedra " + root.version;
                title-bold: true;
                summary: root.update-check-status != "" ? root.update-check-status
                    : root.update-version != "" ? "Huedra " + root.update-version + " is available."
                    : root.update-note;
                open: true;
                action-text: !root.can-check-updates ? "" : root.checking-updates ? "Checking..." : "Check for updates";
                action-enabled: !root.checking-updates;
                action => {
                    root.check-updates();
                }
                SubRow {
                    first: true;
                    title: "Support Huedra";
                    description: "Like Huedra? A GitHub star or a coffee helps keep it going. Supporters are thanked by name and get early builds. Every feature stays free.";
                    if root.has-project-page: ActionButton {
                        text: "Star on GitHub";
                        clicked => {
                            root.open-project();
                        }
                    }
                    ActionButton {
                        text: "Buy me a coffee";
                        clicked => {
                            root.open-support();
                        }
                    }
                }
                SubRow {
                    title: "Settings and logs";
                    description: root.data-folder;
                }
                SubRow {
                    title: "Disclaimer";
                    description: "What Huedra changes, and the terms you accepted.";
                    ActionButton {
                        text: "Show";
                        clicked => {
                            root.show-disclaimer();
                        }
                    }
                }
                SubRow {
                    description: "Game information from PCGamingWiki (pcgamingwiki.com), licensed CC BY-NC-SA 3.0.";
                }
                HorizontalLayout {
                    padding-left: 52px;
                    padding-bottom: 12px;
                    alignment: start;
                    AboutSlint {
                        preferred-height: 120px;
                    }
                }
            }
        }
    }
}
