// The four pages of the settings window and the parts they share.
// Feature doc: docs/features/08-settings-window.md

import { ScrollView, ListView, AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FocusRing, Toggle, ActionButton, SearchBox, NumberBox, Dropdown, CopyField, TextBox } from "controls.slint";

export struct GameRow {
    id: string,
    name: string,
    icon: image,
    initial: string,
    store: string,
    detail: string,
    setting: string,
    running: bool,
}

export struct GameDetail {
    id: string,
    name: string,
    icon: image,
    initial: string,
    store: string,
    path: string,
    setting-index: int,
    delay: int,
    hold: int,
    custom-timing: bool,
    manual: bool,
    looked-up: bool,
    info: string,
    notes: string,
    ray-tracing: string,
    wiki-url: string,
    suggestion: string,
    suggestion-index: int,
    // Steam launch option for Launch with HDR; empty for other stores.
    launch-option: string,
    // Whether a desktop shortcut can start it with HDR (its program is known).
    shortcut: bool,
    // Result of the last shortcut made for it.
    launch-note: string,
}

export struct DisplayRow {
    id: string,
    number: int,
    title: string,
    detail: string,
    capable: bool,
    managed: bool,
    hdr-on: bool,
}

export struct VideoAppRow {
    key: string,
    name: string,
    choices: [string],
    index: int,
    active: bool,
}

export struct SiteRow {
    key: string,
    name: string,
    address: string,
    on: bool,
}

export struct HistoryRow {
    time: string,
    title: string,
    detail: string,
    kind: string,
}

export struct StoreChip {
    key: string,
    label: string,
    count: int,
}

// ---- Shared parts -----------------------------------------------------

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
}

component PageTitle inherits Text {
    font-size: Theme.title-size;
    font-weight: 600;
    color: Theme.text;
    accessible-role: text;
}

component SectionTitle inherits Text {
    font-size: 16px;
    font-weight: 600;
    color: Theme.text;
}

component Caption inherits Text {
    font-size: Theme.caption-size;
    color: Theme.text-muted;
    wrap: word-wrap;
}

// Centres its children vertically without capping the row it sits in. A
// row is never taller than the smallest maximum height among its parts, and
// fixed-height controls have one, so wrapped text beside them was cut off.
component Centered inherits VerticalLayout {
    Rectangle {
        vertical-stretch: 1;
    }
    @children
    Rectangle {
        vertical-stretch: 1;
    }
}

// A game's icon, or its first letter on a tinted square while it has none.
component GameIcon inherits Rectangle {
    in property <image> icon;
    in property <string> initial;
    in property <length> size: 32px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 5;
    clip: true;
    background: root.icon.width > 0 ? transparent : Theme.surface-raised;
    accessible-role: none;
    if root.icon.width > 0: Image {
        width: parent.width;
        height: parent.height;
        source: root.icon;
        image-fit: contain;
    }
    if root.icon.width == 0: Text {
        text: root.initial;
        font-size: root.size * 0.45;
        font-weight: 600;
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SettingRow inherits Card {
    in property <string> title;
    in property <string> description;
    min-height: 64px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: Theme.body-size;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.description != "": Caption {
                text: root.description;
            }
        }
        Centered {
            horizontal-stretch: 0;
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                @children
            }
        }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <string> kind; // hdr, sdr, external, failed
    height: 22px;
    width: label.preferred-width + 16px;
    border-radius: 11px;
    background: kind == "hdr" ? #FF2D6F26 : kind == "external" ? #9B3DFF26 : kind == "failed" ? #FF2D6F14 : #A9A4B633;
    border-width: kind == "failed" ? 1px : 0px;
    border-color: Theme.hdr-label;
    label := Text {
        text: root.text;
        font-size: Theme.caption-size;
        font-weight: 600;
        color: kind == "hdr" || kind == "failed" ? Theme.hdr-label : kind == "external" ? Theme.violet : Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A three-way segmented control for the mode; Left and Right change it.
component ModeSelector inherits Rectangle {
    in property <int> mode;
    callback chosen(int);
    height: Theme.button-height + 4px;
    border-radius: Theme.radius-control + 2px;
    background: Theme.surface-raised;
    forward-focus: focus;
    accessible-role: tab-list;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for label[i] in ["Automatic", "Always HDR", "Always SDR"]: Rectangle {
            property <bool> selected: root.mode == i;
            border-radius: Theme.radius-control;
            background: selected ? Theme.accent : touch.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.control; }
            accessible-role: tab;
            accessible-label: label;
            accessible-item-selected: selected;
            accessible-action-default => {
                root.chosen(i);
            }
            Text {
                text: label;
                font-size: Theme.body-size;
                font-weight: selected ? 600 : 400;
                color: selected ? Theme.on-accent : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            touch := TouchArea {
                clicked => {
                    root.chosen(i);
                }
            }
        }
    }
    focus := FocusScope {
        x: 0;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.LeftArrow && root.mode > 0 {
                root.chosen(root.mode - 1);
                return accept;
            }
            if event.text == Key.RightArrow && root.mode < 2 {
                root.chosen(root.mode + 1);
                return accept;
            }
            reject
        }
    }
    if focus.has-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.border-radius + 3px;
    }
}

// The status card: grey in SDR; the spectrum fades in while HDR is on.
component HeroCard inherits Rectangle {
    in property <bool> hdr-on;
    in property <string> headline;
    in property <string> detail;
    in property <string> caption;
    min-height: 150px;
    border-radius: Theme.radius-card;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    Image {
        source: Theme.spectrum-image;
        image-fit: fill;
        width: parent.width;
        height: parent.height;
        opacity: root.hdr-on ? 1 : 0;
        animate opacity { duration: Theme.fade; easing: ease-in-out; }
    }
    VerticalLayout {
        padding: 24px;
        spacing: 6px;
        alignment: center;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                border-radius: 7px;
                background: root.hdr-on ? #FFFFFF : transparent;
                border-width: root.hdr-on ? 0px : 2px;
                border-color: Theme.sdr;
            }
            Text {
                text: root.headline;
                font-size: Theme.title-size;
                font-weight: 600;
                color: root.hdr-on ? #FFFFFF : Theme.text;
                animate color { duration: Theme.fade; }
            }
        }
        Text {
            text: root.detail;
            font-size: Theme.body-size;
            color: root.hdr-on ? #FFFFFFF0 : Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: root.caption;
            font-size: Theme.caption-size;
            color: root.hdr-on ? #FFFFFFCC : Theme.text-muted;
            wrap: word-wrap;
        }
    }
}

// ---- Status -----------------------------------------------------------

export component StatusPage inherits Rectangle {
    in property <bool> tray-running;
    in property <bool> hdr-on;
    in property <string> headline;
    in property <string> detail;
    in property <string> caption;
    in property <int> mode;
    in property <bool> paused;
    in property <string> pause-note;
    in property <[HistoryRow]> history;
    callback set-mode(int);
    callback toggle-pause();
    callback start-huedra();

    ScrollView {
        // At least the preferred height, so rows keep their wrapped text
        // when the page is taller than the window (the default is the
        // minimum height, which squeezes them). Setting one size drops the
        // default for the other, so the width is set as well.
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            padding: 28px;
            spacing: Theme.gap;
            alignment: start;
            PageTitle {
                text: "Status";
            }
            if !root.tray-running: Card {
                background: Theme.surface-raised;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Caption {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: "Huedra is not running, so HDR is not switched automatically.";
                        color: Theme.text;
                    }
                    ActionButton {
                        text: "Start Huedra";
                        primary: true;
                        clicked => {
                            root.start-huedra();
                        }
                    }
                }
            }
            HeroCard {
                hdr-on: root.hdr-on;
                headline: root.headline;
                detail: root.detail;
                caption: root.caption;
            }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    SectionTitle {
                        text: "Mode";
                    }
                    Caption {
                        text: "Automatic mode follows the setting of each game. The other two modes stay in effect until changed.";
                    }
                    ModeSelector {
                        mode: root.mode;
                        chosen(i) => {
                            root.set-mode(i);
                        }
                    }
                }
            }
            SettingRow {
                title: "Pause automatic switching";
                description: root.paused ? root.pause-note : "The current state is kept and no switching occurs until the pause ends.";
                ActionButton {
                    text: root.paused ? "Resume" : "Pause for 1 hour";
                    enabled: root.tray-running;
                    clicked => {
                        root.toggle-pause();
                    }
                }
            }
            SectionTitle {
                text: "Recent changes";
            }
            if root.history.length == 0: Caption {
                text: "No changes since Huedra started.";
            }
            for entry in root.history: Card {
                HorizontalLayout {
                    padding: 12px;
                    spacing: 14px;
                    Text {
                        text: entry.time;
                        font-size: Theme.caption-size;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        width: 40px;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: entry.title;
                            font-size: Theme.body-size;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Caption {
                            text: entry.detail;
                        }
                    }
                    Centered {
                        Badge {
                            kind: entry.kind;
                            text: entry.kind == "hdr" ? "HDR" : entry.kind == "external" ? "External" : entry.kind == "failed" ? "Failed" : "SDR";
                        }
                    }
                }
            }
        }
    }
}

// ---- Games ------------------------------------------------------------

component GameDetailPanel inherits Card {
    in property <GameDetail> detail;
    in property <bool> show-back;
    callback back();
    callback set-setting(string, int);
    callback set-delay(string, int);
    callback set-hold(string, int);
    callback reset-timing(string);
    callback apply-suggestion(string);
    callback open-wiki(string);
    callback remove-game(string);
    callback create-shortcut(string);

    ScrollView {
        // At least the preferred height, so rows keep their wrapped text
        // when the page is taller than the window (the default is the
        // minimum height, which squeezes them). Setting one size drops the
        // default for the other, so the width is set as well.
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            alignment: start;
            if root.show-back: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Back to the list";
                    clicked => {
                        root.back();
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Centered {
                    GameIcon {
                        size: 40px;
                        icon: root.detail.icon;
                        initial: root.detail.initial;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.detail.name;
                    font-size: Theme.heading-size;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            Caption {
                text: root.detail.store + " · " + root.detail.path;
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "HDR setting";
                    font-size: Theme.body-size;
                    color: Theme.text;
                }
                Dropdown {
                    model: ["Enable while running", "Do not change", "Game controls HDR"];
                    current-index: root.detail.setting-index;
                    selected(value) => {
                        root.set-setting(root.detail.id, self.current-index);
                    }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Delay before enabling HDR (seconds)";
                        font-size: Theme.body-size;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    NumberBox {
                        minimum: 0;
                        maximum: 120;
                        value: root.detail.delay;
                        edited(v) => {
                            root.set-delay(root.detail.id, v);
                        }
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Hold time after exit (seconds)";
                        font-size: Theme.body-size;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    NumberBox {
                        minimum: 0;
                        maximum: 600;
                        value: root.detail.hold;
                        edited(v) => {
                            root.set-hold(root.detail.id, v);
                        }
                    }
                }
            }
            if root.detail.custom-timing: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Use the default times";
                    clicked => {
                        root.reset-timing(root.detail.id);
                    }
                }
            }
            if root.detail.launch-option != "" || root.detail.shortcut: Rectangle {
                height: 1px;
                background: Theme.border;
            }
            if root.detail.launch-option != "" || root.detail.shortcut: SectionTitle {
                text: "Start with HDR";
            }
            if root.detail.launch-option != "" || root.detail.shortcut: Caption {
                text: "For games that go wrong when HDR changes while they start. HDR is turned on first, then the game starts, and HDR stays on until it closes.";
            }
            if root.detail.launch-option != "": VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Steam launch option (in Steam: the game's Properties, General, Launch options)";
                    font-size: Theme.body-size;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                CopyField {
                    text: root.detail.launch-option;
                    label: "Steam launch option";
                }
            }
            if root.detail.shortcut: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Create a desktop shortcut";
                    clicked => {
                        root.create-shortcut(root.detail.id);
                    }
                }
            }
            if root.detail.launch-note != "": Caption {
                text: root.detail.launch-note;
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            SectionTitle {
                text: "From PCGamingWiki";
            }
            Text {
                text: root.detail.info;
                font-size: Theme.body-size;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.detail.notes != "": Caption {
                text: "\"" + root.detail.notes + "\"";
            }
            if root.detail.ray-tracing != "": Caption {
                text: "Ray tracing: " + root.detail.ray-tracing;
            }
            if root.detail.suggestion != "" && root.detail.suggestion-index != root.detail.setting-index: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Use the suggested setting: " + root.detail.suggestion;
                    clicked => {
                        root.apply-suggestion(root.detail.id);
                    }
                }
            }
            if root.detail.wiki-url != "": HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Open the PCGamingWiki page";
                    clicked => {
                        root.open-wiki(root.detail.wiki-url);
                    }
                }
            }
            if root.detail.looked-up: Caption {
                text: "Source: PCGamingWiki, licensed CC BY-NC-SA 3.0. Suggestions are never applied automatically.";
            }
            if root.detail.manual: HorizontalLayout {
                alignment: start;
                ActionButton {
                    text: "Remove this game";
                    clicked => {
                        root.remove-game(root.detail.id);
                    }
                }
            }
        }
    }
}

export component GamesPage inherits Rectangle {
    in property <bool> wide;
    in property <[GameRow]> games;
    in property <[StoreChip]> chips;
    in property <string> filter;
    in property <int> total;
    // The selected game, as a list of zero or one entries: a new list makes a
    // fresh detail panel (another game, or values changed from outside the
    // controls); the same game is updated in place and keeps the focus.
    in property <[GameDetail]> details;
    in property <string> selected-id;
    in property <string> scan-note;
    callback search-changed(string);
    callback filter-changed(string);
    callback select-game(string);
    callback close-detail();
    callback add-game();
    callback rescan();
    callback set-setting(string, int);
    callback set-delay(string, int);
    callback set-hold(string, int);
    callback reset-timing(string);
    callback apply-suggestion(string);
    callback open-wiki(string);
    callback remove-game(string);
    callback create-shortcut(string);

    property <bool> has-selection: root.details.length > 0;
    property <bool> list-visible: root.wide || !root.has-selection;
    property <length> row-height: 56px;
    // The row the keyboard is on, and whether the keyboard put it there.
    property <int> cursor: 0;
    property <bool> keyboard;

    function move-cursor(index: int) {
        root.cursor = max(0, min(index, root.games.length - 1));
        root.keyboard = true;
    }

    VerticalLayout {
        padding: 28px;
        padding-bottom: 16px;
        spacing: Theme.gap;
        PageTitle {
            text: "Games";
        }
        HorizontalLayout {
            spacing: 8px;
            SearchBox {
                horizontal-stretch: 1;
                placeholder: "Search " + root.total + " games";
                edited(text) => {
                    root.search-changed(text);
                }
            }
            ActionButton {
                text: "Add game";
                clicked => {
                    root.add-game();
                }
            }
            ActionButton {
                text: "Scan again";
                clicked => {
                    root.rescan();
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for chip in root.chips: Rectangle {
                property <bool> selected: root.filter == chip.key;
                height: 28px;
                width: chip-text.preferred-width + 20px;
                border-radius: 14px;
                background: selected ? Theme.accent : chip-touch.has-hover ? Theme.hover : Theme.surface-raised;
                animate background { duration: Theme.hover-time; }
                accessible-role: button;
                accessible-label: chip.label;
                accessible-item-selected: selected;
                accessible-action-default => {
                    root.filter-changed(chip.key);
                }
                chip-text := Text {
                    text: chip.label + " " + chip.count;
                    font-size: Theme.caption-size;
                    color: selected ? Theme.on-accent : Theme.text;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                chip-touch := TouchArea {
                    clicked => {
                        root.filter-changed(chip.key);
                    }
                }
                chip-focus := FocusScope {
                    x: 0;
                    width: 0px;
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return {
                            root.filter-changed(chip.key);
                            return accept;
                        }
                        reject
                    }
                }
                if chip-focus.has-focus: FocusRing {
                    x: -3px;
                    y: -3px;
                    width: parent.width + 6px;
                    height: parent.height + 6px;
                    border-radius: parent.border-radius + 3px;
                }
            }
        }
        if root.scan-note != "": Caption {
            text: root.scan-note;
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.gap;
            if root.list-visible: Card {
                horizontal-stretch: 3;
                // Up, Down, Home and End move through the list; Enter or Space
                // opens the game. Clicking a row also gives the list the keyboard.
                list-keys := FocusScope {
                    x: 0;
                    width: 0px;
                    focus-gained(reason) => {
                        root.cursor = min(max(root.cursor, 0), root.games.length - 1);
                        root.keyboard = reason == FocusReason.tab-navigation;
                    }
                    key-pressed(event) => {
                        if root.games.length == 0 {
                            return reject;
                        }
                        if event.text == Key.DownArrow {
                            root.move-cursor(root.cursor + 1);
                            return accept;
                        }
                        if event.text == Key.UpArrow {
                            root.move-cursor(root.cursor - 1);
                            return accept;
                        }
                        if event.text == Key.Home {
                            root.move-cursor(0);
                            return accept;
                        }
                        if event.text == Key.End {
                            root.move-cursor(root.games.length - 1);
                            return accept;
                        }
                        if (event.text == Key.Space || event.text == Key.Return) && root.cursor >= 0 && root.cursor < root.games.length {
                            root.keyboard = true;
                            root.select-game(root.games[root.cursor].id);
                            return accept;
                        }
                        reject
                    }
                }
                ListView {
                    // Scrolls just enough to keep the keyboard row in view.
                    property <int> cursor: root.cursor;
                    changed cursor => {
                        let top = self.cursor * root.row-height;
                        if top < -self.content-y {
                            self.content-y = -top;
                        } else if top + root.row-height > self.visible-height - self.content-y {
                            self.content-y = self.visible-height - top - root.row-height;
                        }
                    }
                    for game[i] in root.games: Rectangle {
                        property <bool> selected: root.has-selection && root.selected-id == game.id;
                        height: root.row-height;
                        background: selected ? Theme.surface-raised : row-touch.has-hover ? Theme.hover : transparent;
                        animate background { duration: Theme.hover-time; }
                        accessible-role: list-item;
                        accessible-label: game.name;
                        accessible-item-selected: selected;
                        accessible-action-default => {
                            root.select-game(game.id);
                        }
                        Rectangle {
                            x: 0;
                            width: 3px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 2px;
                            background: selected ? Theme.accent : transparent;
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            Centered {
                                GameIcon {
                                    icon: game.icon;
                                    initial: game.initial;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: game.name;
                                    font-size: Theme.body-size;
                                    font-weight: game.running ? 600 : 400;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: game.detail;
                                    font-size: Theme.caption-size;
                                    color: game.running ? Theme.hdr-label : Theme.text-muted;
                                    overflow: elide;
                                }
                            }
                            // The store and setting columns give way to the
                            // name while the detail panel, which shows both, is open.
                            if root.wide && !root.has-selection: Text {
                                text: game.store;
                                font-size: Theme.caption-size;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                width: 70px;
                            }
                            if !root.has-selection: Text {
                                text: game.setting;
                                font-size: Theme.caption-size;
                                color: Theme.text;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                width: 140px;
                                overflow: elide;
                            }
                        }
                        row-touch := TouchArea {
                            clicked => {
                                root.cursor = i;
                                list-keys.focus();
                                root.keyboard = false;
                                root.select-game(game.id);
                            }
                        }
                        if list-keys.has-focus && root.keyboard && root.cursor == i: FocusRing {
                            width: parent.width;
                            height: parent.height;
                            border-radius: Theme.radius-control;
                        }
                    }
                }
            }
            for detail in root.details: GameDetailPanel {
                horizontal-stretch: 2;
                min-width: 300px;
                detail: detail;
                show-back: !root.wide;
                back => {
                    root.close-detail();
                }
                set-setting(id, i) => {
                    root.set-setting(id, i);
                }
                set-delay(id, v) => {
                    root.set-delay(id, v);
                }
                set-hold(id, v) => {
                    root.set-hold(id, v);
                }
                reset-timing(id) => {
                    root.reset-timing(id);
                }
                apply-suggestion(id) => {
                    root.apply-suggestion(id);
                }
                open-wiki(url) => {
                    root.open-wiki(url);
                }
                remove-game(id) => {
                    root.remove-game(id);
                }
                create-shortcut(id) => {
                    root.create-shortcut(id);
                }
            }
        }
    }
}

// ---- Video players ----------------------------------------------------

// One program in a list card: its name and what Huedra does for it.
component VideoAppLine inherits HorizontalLayout {
    in property <VideoAppRow> app;
    callback chosen(int);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text {
            text: root.app.name;
            font-size: Theme.body-size;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.app.active: Caption {
            text: "Keeping HDR on";
        }
    }
    Centered {
        horizontal-stretch: 0;
        Dropdown {
            width: 220px;
            accessible-label: root.app.name;
            model: root.app.choices;
            current-index: root.app.index;
            selected(value) => {
                root.chosen(self.current-index);
            }
        }
    }
}

// A card listing programs, with a line between them.
component VideoAppList inherits Card {
    in property <[VideoAppRow]> apps;
    callback chosen(string, int);
    VerticalLayout {
        for app[i] in root.apps: VerticalLayout {
            if i > 0: Rectangle {
                height: 1px;
                background: Theme.border;
            }
            VideoAppLine {
                app: app;
                chosen(index) => {
                    root.chosen(app.key, index);
                }
            }
        }
    }
}

export component VideoPage inherits Rectangle {
    in property <[VideoAppRow]> players;
    in property <[VideoAppRow]> browsers;
    in property <string> keywords;
    in property <bool> full-screen-only;
    in property <bool> sdr-with-rtx;
    in property <string> rtx-note;
    in property <[SiteRow]> sites;
    in property <int> hold;
    in property <bool> hold-custom;
    in property <int> default-hold;
    callback set-app(string, int);
    callback set-keywords(string);
    callback set-full-screen-only(bool);
    callback set-sdr-with-rtx(bool);
    callback set-site(string, bool);
    callback set-hold(int);
    callback reset-hold();

    ScrollView {
        // At least the preferred height, so rows keep their wrapped text
        // when the page is taller than the window (the default is the
        // minimum height, which squeezes them). Setting one size drops the
        // default for the other, so the width is set as well.
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            padding: 28px;
            spacing: Theme.gap;
            alignment: start;
            PageTitle {
                text: "Video players";
            }
            Caption {
                text: "HDR turns on while a player shows a file whose name contains one of the words below, and turns off after the hold time once it no longer does.";
            }
            // The field takes the card's width: the words do not fit beside
            // the description in narrow layouts.
            Card {
                VerticalLayout {
                    padding: 16px;
                    padding-top: 12px;
                    spacing: 2px;
                    Text {
                        text: "Words that mark HDR video";
                        font-size: Theme.body-size;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    Caption {
                        text: "Separated by commas; Enter applies them. Whole words count; case, dots, dashes and underscores are ignored. Leave empty for the default words.";
                    }
                    Rectangle {
                        height: 8px;
                    }
                    TextBox {
                        value: root.keywords;
                        label: "Words that mark HDR video";
                        accepted(text) => {
                            root.set-keywords(text);
                        }
                    }
                }
            }
            SettingRow {
                title: "Only in full screen";
                description: "Video in a window leaves the display as it is.";
                Toggle {
                    accessible-label: "Only in full screen";
                    checked: root.full-screen-only;
                    toggled => {
                        root.set-full-screen-only(self.checked);
                    }
                }
            }
            SettingRow {
                title: "SDR video with RTX Video HDR";
                description: root.rtx-note;
                Toggle {
                    accessible-label: "SDR video with RTX Video HDR";
                    checked: root.sdr-with-rtx;
                    toggled => {
                        root.set-sdr-with-rtx(self.checked);
                    }
                }
            }
            SettingRow {
                title: "Hold time for video (seconds)";
                description: root.hold-custom ? "Used instead of the default hold time (" + root.default-hold + " s)." : "The default hold time from General.";
                if root.hold-custom: ActionButton {
                    text: "Use the default";
                    clicked => {
                        root.reset-hold();
                    }
                }
                NumberBox {
                    accessible-label: "Hold time for video";
                    minimum: 0;
                    maximum: 600;
                    value: root.hold;
                    edited(v) => {
                        root.set-hold(v);
                    }
                }
            }
            SectionTitle {
                text: "Players";
            }
            VideoAppList {
                apps: root.players;
                chosen(key, index) => {
                    root.set-app(key, index);
                }
            }
            SectionTitle {
                text: "Browsers";
            }
            Caption {
                text: "Browsers turn HDR on through the Huedra browser extension, which marks the tab while an HDR video is open on YouTube or a full-screen video plays on a streaming site below, and for full-screen video with sound when SDR video with RTX Video HDR applies. Otherwise browsers never change the display.";
            }
            VideoAppList {
                apps: root.browsers;
                chosen(key, index) => {
                    root.set-app(key, index);
                }
            }
            SectionTitle {
                text: "Streaming sites";
            }
            Caption {
                text: "These sites do not show whether a video is in HDR. For a site turned on here, full-screen video counts as HDR video. Turn a site on only if it streams HDR to your browser.";
            }
            for site in root.sites: SettingRow {
                title: site.name;
                description: site.address;
                Toggle {
                    accessible-label: site.name;
                    checked: site.on;
                    toggled => {
                        root.set-site(site.key, self.checked);
                    }
                }
            }
        }
    }
}

// ---- Displays ---------------------------------------------------------

export component DisplaysPage inherits Rectangle {
    in property <[DisplayRow]> displays;
    in property <int> retries;
    in property <bool> content-only;
    callback set-managed(string, bool);
    callback set-retries(int);
    callback set-content-only(bool);

    ScrollView {
        // At least the preferred height, so rows keep their wrapped text
        // when the page is taller than the window (the default is the
        // minimum height, which squeezes them). Setting one size drops the
        // default for the other, so the width is set as well.
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            padding: 28px;
            spacing: Theme.gap;
            alignment: start;
            PageTitle {
                text: "Displays";
            }
            Caption {
                text: "Huedra switches only managed displays. Displays connected later are managed automatically when they support HDR.";
            }
            SettingRow {
                title: "Only the display showing the content";
                description: "A game or video turns HDR on only for the display its window is on, and HDR follows the window to another display. Off: every managed display switches together.";
                Toggle {
                    accessible-label: "Only the display showing the content";
                    checked: root.content-only;
                    toggled => {
                        root.set-content-only(self.checked);
                    }
                }
            }
            for d in root.displays: Card {
                HorizontalLayout {
                    padding: 16px;
                    spacing: 14px;
                    Centered {
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: Theme.radius-control;
                            clip: true;
                            background: Theme.surface-raised;
                            if d.hdr-on: Image {
                                source: Theme.spectrum-image;
                                image-fit: fill;
                                width: parent.width;
                                height: parent.height;
                            }
                            Text {
                                text: d.number;
                                font-size: 16px;
                                font-weight: 600;
                                color: d.hdr-on ? #FFFFFF : Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: d.title;
                            font-size: Theme.body-size;
                            font-weight: 600;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Caption {
                            text: d.detail;
                        }
                    }
                    Centered {
                        Toggle {
                            text: d.capable ? (self.checked ? "Managed" : "Not managed") : "Not managed";
                            checked: d.managed;
                            enabled: d.capable;
                            toggled => {
                                root.set-managed(d.id, self.checked);
                            }
                        }
                    }
                }
            }
            SettingRow {
                title: "Retry attempts";
                description: "Some displays reject the first request while the graphics card changes mode.";
                NumberBox {
                    accessible-label: "Retry attempts";
                    minimum: 0;
                    maximum: 5;
                    value: root.retries;
                    edited(v) => {
                        root.set-retries(v);
                    }
                }
            }
        }
    }
}

// ---- General ----------------------------------------------------------

export component GeneralPage inherits Rectangle {
    in property <bool> start-with-windows;
    in property <bool> context-menu;
    in property <int> updates;
    in property <bool> game-info;
    in property <int> hold;
    in property <int> delay;
    in property <bool> hotkeys;
    in property <string> hotkey-note;
    in property <bool> log-titles;
    in property <string> version;
    in property <string> data-folder;
    in property <string> update-note;
    callback set-start-with-windows(bool);
    callback set-context-menu(bool);
    callback set-updates(int);
    callback set-game-info(bool);
    callback set-hold(int);
    callback set-delay(int);
    callback set-hotkeys(bool);
    callback set-log-titles(bool);

    ScrollView {
        // At least the preferred height, so rows keep their wrapped text
        // when the page is taller than the window (the default is the
        // minimum height, which squeezes them). Setting one size drops the
        // default for the other, so the width is set as well.
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            padding: 28px;
            spacing: Theme.gap;
            alignment: start;
            PageTitle {
                text: "General";
            }
            SettingRow {
                title: "Start with Windows";
                description: "Starts in the notification area without opening a window.";
                Toggle {
                    accessible-label: "Start with Windows";
                    checked: root.start-with-windows;
                    toggled => {
                        root.set-start-with-windows(self.checked);
                    }
                }
            }
            SettingRow {
                title: "\"Start with HDR\" in the menu of programs";
                description: "Right-click a program in File Explorer and choose Show more options, then Start with HDR. HDR turns on before the program starts and stays on until it closes.";
                Toggle {
                    accessible-label: "\"Start with HDR\" in the menu of programs";
                    checked: root.context-menu;
                    toggled => {
                        root.set-context-menu(self.checked);
                    }
                }
            }
            SettingRow {
                title: "Updates";
                description: "Checks once a day and installs signed releases while no game or video is running. The previous version is kept; huedra update --rollback restores it." + (root.update-note != "" ? " " + root.update-note : "");
                Dropdown {
                    accessible-label: "Updates";
                    model: ["Install automatically", "Ask before installing", "Off"];
                    current-index: root.updates;
                    selected(value) => {
                        root.set-updates(self.current-index);
                    }
                }
            }
            SettingRow {
                title: "Game information and icons";
                description: "Looks up HDR support on pcgamingwiki.com, which receives the Steam ID or the name of each game, and icons in Discord's public list of games. Results are stored for 30 days. When off, icons come from the games' own programs.";
                Toggle {
                    accessible-label: "Game information and icons";
                    checked: root.game-info;
                    toggled => {
                        root.set-game-info(self.checked);
                    }
                }
            }
            SettingRow {
                title: "Default hold time (seconds)";
                description: "Used for games without their own setting, and for video unless set on the Video players page.";
                NumberBox {
                    accessible-label: "Default hold time (seconds)";
                    minimum: 0;
                    maximum: 600;
                    value: root.hold;
                    edited(v) => {
                        root.set-hold(v);
                    }
                }
            }
            SettingRow {
                title: "Default delay before enabling HDR (seconds)";
                description: "Used for games without their own setting.";
                NumberBox {
                    accessible-label: "Default delay before enabling HDR (seconds)";
                    minimum: 0;
                    maximum: 120;
                    value: root.delay;
                    edited(v) => {
                        root.set-delay(v);
                    }
                }
            }
            SettingRow {
                title: "Keyboard shortcuts";
                description: "Win+Alt+H turns HDR on or off. Win+Alt+O changes the mode. Win+Alt+P pauses or resumes." + (root.hotkey-note != "" ? " " + root.hotkey-note : "");
                Toggle {
                    accessible-label: "Keyboard shortcuts";
                    checked: root.hotkeys;
                    toggled => {
                        root.set-hotkeys(self.checked);
                    }
                }
            }
            SettingRow {
                title: "Record window titles in the log";
                description: "When off, browser tab names and file names are not written to the log.";
                Toggle {
                    accessible-label: "Record window titles in the log";
                    checked: root.log-titles;
                    toggled => {
                        root.set-log-titles(self.checked);
                    }
                }
            }
            SectionTitle {
                text: "About";
            }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "Huedra " + root.version;
                        font-size: Theme.body-size;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    Caption {
                        text: "Settings and logs: " + root.data-folder;
                    }
                    Caption {
                        text: "Game information from PCGamingWiki (pcgamingwiki.com), licensed CC BY-NC-SA 3.0.";
                    }
                    HorizontalLayout {
                        alignment: start;
                        AboutSlint {
                            preferred-height: 120px;
                        }
                    }
                }
            }
        }
    }
}
