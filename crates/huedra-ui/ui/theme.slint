// Design tokens (docs/features/15-design.md): Windows 11 neutral layers,
// one fixed accent (Windows' default blue, never the user's accent, which
// could be pink, the color of HDR here), the Windows status colors, the
// BT.2020 spectrum for HDR only, and motion that turns off when Windows
// "Animation effects" is off.

import { Palette } from "std-widgets.slint";

export global Theme {
    in property <bool> motion: true;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Spectrum (HDR only).
    out property <color> pink: #FF2D6F;
    out property <color> violet: #9B3DFF;
    out property <color> ultramarine: #3341E6;
    out property <color> cyan: #00C8F0;
    out property <color> green: #14D98A;
    // Drawn in Rust (huedra_core::icon) so every renderer shows it without seams.
    in property <image> spectrum-image;
    // The program icon as vector images, drawn sharp at any display scale:
    // the color gamut while HDR is on, a gray outline of it in SDR.
    out property <image> logo-hdr: @image-url("assets/logo-hdr.svg");
    out property <image> logo-sdr: @image-url("assets/logo-sdr.svg");
    // The Status card's color chart: the BT.2020 triangle around the sRGB
    // triangle, in color while HDR is on and gray in SDR.
    out property <image> chart-hdr: @image-url("assets/chart-hdr.svg");
    out property <image> chart-sdr: @image-url("assets/chart-sdr.svg");

    // Neutrals, as Windows 11's layers.
    out property <color> background: dark ? #202020 : #F3F3F3;
    out property <color> surface: dark ? #2B2B2B : #FBFBFB;
    out property <color> surface-raised: dark ? #383838 : #EDEDED;
    out property <color> hover: dark ? #323232 : #F3F3F3;
    out property <color> border: dark ? #1D1D1D : #E5E5E5;
    out property <color> divider: dark ? #3A3A3A : #EAEAEA;
    out property <color> text: dark ? #FFFFFF : #1A1A1A;
    out property <color> text-muted: dark ? #C8C8C8 : #5F5F5F;
    out property <color> sdr: #9E9E9E;
    // The main action, switches that are on and selection marks.
    out property <color> accent: dark ? #60CDFF : #005FB8;
    out property <color> on-accent: dark ? #000000 : #FFFFFF;
    // Keyboard focus outline, as in Windows 11: the strongest neutral.
    out property <color> focus: dark ? #FFFFFF : #1A1A1A;
    // Status, as Windows' InfoBar: done, warnings, errors.
    out property <color> success: dark ? #6CCB5F : #0F7B0F;
    out property <color> success-bg: dark ? #393D1B : #DFF6DD;
    out property <color> caution: dark ? #FCE100 : #9D5D00;
    out property <color> caution-bg: dark ? #433519 : #FFF4CE;
    out property <color> critical: dark ? #FF99A4 : #C42B1C;
    out property <color> critical-bg: dark ? #442726 : #FDE7E9;
    out property <color> info-bg: dark ? #1F3242 : #E5F1FB;
    // HDR labels use pink, and only they do.
    out property <color> hdr-label: dark ? #FF6F9A : #C4174F;
    // Violet text and marks (suggestions, information), readable on both.
    out property <color> violet-text: dark ? #B57BFF : #7A2BE0;

    // Sizes.
    out property <length> radius-control: 4px;
    out property <length> radius-card: 8px;
    out property <length> button-height: 32px;
    out property <length> nav-row: 36px;
    out property <length> gap: 12px;
    // Pages stop at this width (content 1000 px plus the page padding) and
    // stay beside the navigation, as Microsoft's settings guidance has it.
    out property <length> page-width: 1056px;
    out property <length> page-padding: 28px;

    // Type.
    out property <length> title-size: 28px;
    out property <length> heading-size: 20px;
    out property <length> body-size: 14px;
    out property <length> caption-size: 12px;
    out property <string> icons: "Segoe Fluent Icons";

    // Motion.
    out property <duration> fade: motion ? 400ms : 0ms;
    out property <duration> page: motion ? 150ms : 0ms;
    out property <duration> control: motion ? 120ms : 0ms;
    out property <duration> hover-time: motion ? 80ms : 0ms;
}
